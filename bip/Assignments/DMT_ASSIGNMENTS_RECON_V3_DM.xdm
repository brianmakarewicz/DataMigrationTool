<?xml version="1.0" encoding="utf-8"?>
<!-- DMT_ASSIGNMENTS_RECON_V3_DM (2026-10-10, backlog #734): the SQL, parameters and output are identical to DMT_ASSIGNMENTS_RECON_V2_DM. This version exists only because its report wrapper DMT_ASSIGNMENTS_RECON_V3_RPT.xdo is deployed with BIP data caching off, so a repeated call with the same parameters reads Fusion again instead of a cached result. Deployed alongside DMT_ASSIGNMENTS_RECON_V2_DM, which is never overwritten. -->
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_ASSIGNMENTS_RECON_V2_DM - Contract v1 reconciliation data model for the
    work relationship and assignment tiers of the Workers HDL load (design
    section 5, "BIP reconciliation report contract - v1"). Version 2, deployed
    ALONGSIDE DMT_ASSIGNMENTS_RECON_DM (BIP objects are never overwritten).

    What changed from V1 (backlog #287, #290):
      * Rows are SELECTED by the HDL request id, never by the run prefix (design
        section 5, "Reports find rows by Fusion job id"). P_LOAD_REQUEST_ID is the
        HDL data set RequestId the load returned; HRC_DL_DATA_SET_BUS_OBJS carries
        it, and its file lines and file rows give every SourceSystemOwner and
        SourceSystemId this load sent.
      * No SourceSystemOwner literal. V1 filtered the key map on 'HRC_SQLLOADER';
        the owner is now per DMT instance (DMT_LOCAL / DMT_ATP), so each data-set
        row is joined to HRC_INTEGRATION_KEY_MAP on its OWN owner and id.
      * A row is returned only when this load's physical line for it finished
        LOADED_SUCCESS and the key-map surrogate exists in the base table.
      * Nine contract columns (SOURCE_REF = the SourceSystemId, DMT_REFERENCE NULL).

    Tiers (OBJECT_TYPE discriminator):
      'WorkRelationship' - key-map object PeriodOfService, base PER_PERIODS_OF_SERVICE.
          FUSION_ID = the real PERSON_ID (stamped into DMT_WORK_REL_TFM_TBL
          FUSION_PERSON_ID, unchanged from V1). RECORD_KEY = '<person>_POS'.
      'Assignment' - key-map object Assignment, base PER_ALL_ASSIGNMENTS_M.
          FUSION_ID = ASSIGNMENT_ID. RECORD_KEY = '<assignment>_ASG', plus the
          WorkTerms sibling '<assignment>_TRM' (same key-map object).

    BASE / SUCCESS rows only: HDL per-record failures arrive in the HDL REST
    messages. Keyset pagination on RECORD_KEY pinned to BINARY.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="assignments_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type,
       record_key,
       source_type,
       fusion_status,
       fusion_id,
       error_message,
       load_request_id,
       source_ref,
       dmt_reference
FROM (
    SELECT DECODE(m.object_name, 'PeriodOfService', 'WorkRelationship', m.object_name) AS object_type,
           r.key_source_id                   AS record_key,
           'BASE'                            AS source_type,
           'SUCCESS'                         AS fusion_status,
           MAX(DECODE(m.object_name, 'PeriodOfService', pos.person_id, a.assignment_id)) AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))      AS error_message,
           :P_LOAD_REQUEST_ID                AS load_request_id,
           r.key_source_id                   AS source_ref,
           CAST(NULL AS VARCHAR2(240))       AS dmt_reference
    FROM   hrc_dl_data_set_bus_objs b
    JOIN   hrc_dl_file_lines        l   ON l.data_set_bus_obj_id = b.data_set_bus_obj_id
    JOIN   hrc_dl_file_rows         r   ON r.line_id = l.line_id
    JOIN   hrc_integration_key_map  m   ON m.source_system_owner = r.key_source_owner
                                       AND m.source_system_id    = r.key_source_id
    LEFT JOIN per_periods_of_service pos ON m.object_name = 'PeriodOfService'
                                        AND pos.period_of_service_id = m.surrogate_id
    LEFT JOIN per_all_assignments_m  a   ON m.object_name = 'Assignment'
                                        AND a.assignment_id = m.surrogate_id
    WHERE  b.request_id = :P_LOAD_REQUEST_ID
    AND    m.object_name IN ('PeriodOfService', 'Assignment')
    AND    EXISTS (SELECT 1
                   FROM   hrc_dl_physical_lines p
                   WHERE  p.row_id = r.row_id
                   AND    p.validated_loaded_status = 'LOADED_SUCCESS')
    GROUP BY m.object_name, r.key_source_id
)
WHERE  fusion_id IS NOT NULL
AND    (:P_AFTER_KEY IS NULL
        OR NLSSORT(record_key, 'NLS_SORT=BINARY') > NLSSORT(:P_AFTER_KEY, 'NLS_SORT=BINARY'))
ORDER BY NLSSORT(record_key, 'NLS_SORT=BINARY')
FETCH FIRST :P_CHUNK_SIZE ROWS ONLY
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="assignments_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:string"  tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
