<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="gl_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- ============================================================
-- GLBalances reconciliation data model — BIP Reconciliation
-- Standard, reference implementation (P1). Returns the SIX
-- standard columns for every row and pages with OFFSET/FETCH:
--   RECORD_KEY, FUSION_ID, SOURCE_REF, DMT_REFERENCE,
--   SOURCE_TYPE (BASE|INTERFACE), ERROR_MESSAGE.
--
-- Row selection (documented): base rows are joined to the run's
-- own GL journal batch by GL_JE_BATCHES.GROUP_ID = :P_RUN_ID
-- (the pipeline run id is written as GROUP_ID at transform time
-- and survives Journal Import — proven live against runs 304/305).
-- Interface rows are selected by the load ESS request id the
-- interface table carries (:P_LOAD_REQUEST_ID). No prefix / LIKE
-- fallback is needed for GL because GROUP_ID carries the run id
-- exactly. (:P_PREFIX is still declared for contract symmetry but
-- is not used in the query.)
--
-- GL two-tier semantics preserved WITHOUT an IMPORT_STATUS column:
--   BASE  + ERROR_MESSAGE IS NULL  => postable (balanced) => LOADED
--   BASE  + ERROR_MESSAGE NOT NULL => imported-but-unbalanced,
--                                     will not post => FAILED
--   The header balance (running_total_dr = running_total_cr)
--   populates ERROR_MESSAGE only when the journal is unbalanced.
--
-- Keys (proven 2026-07-11; needs source "Import Journal
-- References" = ON):
--   RECORD_KEY / SOURCE_REF = GL_JE_LINES.REFERENCE_1
--       (per-line recon key, = TFM RECON_KEY),
--   DMT_REFERENCE           = GL_JE_LINES.REFERENCE_2
--       (run-scoped reference stamped into GL_INTERFACE.REFERENCE22),
--   FUSION_ID               = GL_JE_HEADERS.JE_HEADER_ID.
-- Matching is per LINE, so journals sharing a name never collide.
-- ============================================================
SELECT * FROM (
    -- Tier 1: rows still in GL_INTERFACE after import are
    -- rejections (import DELETEs successfully-imported rows).
    -- REFERENCE10 carries the import error message; REFERENCE21 /
    -- REFERENCE22 carry our per-line key and run-scoped reference.
    SELECT
        gi.reference21                       AS record_key,
        CAST(NULL AS NUMBER)                 AS fusion_id,
        gi.reference21                       AS source_ref,
        gi.reference22                       AS dmt_reference,
        'INTERFACE'                          AS source_type,
        gi.reference10                       AS error_message
    FROM   gl_interface gi
    WHERE  gi.load_request_id = :P_LOAD_REQUEST_ID

    UNION ALL

    -- Tier 2: one row per GL_JE_LINES line for this run
    -- (GROUP_ID = :P_RUN_ID), keyed on REFERENCE_1. Header balance
    -- discriminates postable (LOADED) vs unbalanced (FAILED).
    SELECT
        jl.reference_1                       AS record_key,
        jh.je_header_id                      AS fusion_id,
        jl.reference_1                       AS source_ref,
        jl.reference_2                       AS dmt_reference,
        'BASE'                               AS source_type,
        CASE WHEN jh.running_total_dr <> jh.running_total_cr
             THEN 'Journal imported (JE_HEADER_ID=' || jh.je_header_id
                  || ') but UNBALANCED: DR=' || jh.running_total_dr
                  || ' CR=' || jh.running_total_cr || '. Will not post.'
        END                                  AS error_message
    FROM   gl_je_batches jb
    JOIN   gl_je_headers jh ON jh.je_batch_id = jb.je_batch_id
    JOIN   gl_je_lines   jl ON jl.je_header_id = jh.je_header_id
    WHERE  jb.group_id = :P_RUN_ID

    ORDER BY source_type, record_key
)
OFFSET :P_OFFSET ROWS FETCH NEXT :P_LIMIT ROWS ONLY
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="gl_results">
          <element name="RECORD_KEY"    value="RECORD_KEY"    dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="FUSION_ID"     value="FUSION_ID"     dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="SOURCE_REF"    value="SOURCE_REF"    dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE" value="DMT_REFERENCE" dataType="xsd:string"  tagName="DMT_REFERENCE"/>
          <element name="SOURCE_TYPE"   value="SOURCE_TYPE"   dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="ERROR_MESSAGE" value="ERROR_MESSAGE" dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="1"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="2"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="3"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <!-- Pagination: OFFSET/FETCH NEXT. The reconciler pages through
         with P_OFFSET/P_LIMIT until a short page returns. -->
    <parameter name="P_OFFSET" dataType="integer" rowPlacement="5"
               labelID="P_OFFSET" defaultValue="0" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LIMIT" dataType="integer" rowPlacement="6"
               labelID="P_LIMIT" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
