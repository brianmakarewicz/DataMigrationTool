<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="gl_bal_cmp_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- GLBalances post-run comparison V2 (backlog #173): every journal of a run
-- carries its own GROUP_ID = run id * 1000000 + journal number, so the run's
-- batches are the GROUP_ID range of P_BATCH_ID (the run id). Deployed
-- alongside GL_BAL_CMP_DM, never overwriting it.
SELECT COUNT(*)                                             AS success_count,
       NVL(SUM(jl.entered_dr), 0)                           AS success_amount,
       MAX(jh.currency_code)                                AS amount_currency
FROM   gl_je_batches jb
JOIN   gl_je_headers jh ON jh.je_batch_id = jb.je_batch_id
JOIN   gl_je_lines   jl ON jl.je_header_id = jh.je_header_id
WHERE  jb.group_id BETWEEN TO_NUMBER(:P_BATCH_ID) * 1000000 + 1
                      AND TO_NUMBER(:P_BATCH_ID) * 1000000 + 999999
AND    jh.running_total_dr = jh.running_total_cr
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="gl_bal_cmp_results">
          <element name="SUCCESS_COUNT"    value="SUCCESS_COUNT"    dataType="xsd:string" tagName="SUCCESS_COUNT"/>
          <element name="SUCCESS_AMOUNT"   value="SUCCESS_AMOUNT"   dataType="xsd:string" tagName="SUCCESS_AMOUNT"/>
          <element name="AMOUNT_CURRENCY"  value="AMOUNT_CURRENCY"  dataType="xsd:string" tagName="AMOUNT_CURRENCY"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_BATCH_ID" dataType="character" rowPlacement="1"
               labelID="P_BATCH_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
