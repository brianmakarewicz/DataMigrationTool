<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_TAX_CARD_RECON_DM - Contract v1 reconciliation data model for TaxCards
    (US tax-withholding calculation cards, loaded via HCM Data Loader).

    Returns the BASE tier for the TaxCards HDL load: one row per migrated
    calculation-card object that is positively confirmed in a Fusion HCM payroll
    base table, with its real Fusion base-table id as FUSION_ID. HDL per-record
    failures arrive in the HDL response (tagged [FUSION_ERROR] by RECONCILE_HDL
    before this report runs), so this report returns the BASE tier only - the
    reconciler promotes a TaxCards TFM row to LOADED only from a
    BASE / SUCCESS / FUSION_ID-not-null row here.

    Driven off HRC_INTEGRATION_KEY_MAP scoped to SOURCE_SYSTEM_OWNER='HRC_SQLLOADER'
    and SOURCE_SYSTEM_ID LIKE :P_PREFIX || '%'. The TaxCards HDL generator
    (DMT_TAX_CARD_HDL_GEN_PKG) emits two DAT discriminators, each recorded by the
    loader under its own OBJECT_NAME with its own SourceSystemId suffix:

      HDL discriminator   OBJECT_NAME in map            SourceSystemId written        base table / PK
      CalculationCard     CalculationCard               PERSON_NUMBER||'_TAXCARD'     PAY_DIR_CARDS_F.DIR_CARD_ID
      CardComponent       CalculationCardComponents     PERSON_NUMBER||'_TAXCOMP'     PAY_DIR_CARD_COMPONENTS_F.DIR_CARD_COMP_ID

    We surface both tiers with distinct OBJECT_TYPE values ('CalculationCard',
    'CalculationCardComponents') so a multi-component tax card reconciles per
    component. SURROGATE_ID -> FUSION_ID; verified live 2026-09-20 that
    HRC_INTEGRATION_KEY_MAP.SURROGATE_ID for OBJECT_NAME='CalculationCard' equals
    PAY_DIR_CARDS_F.DIR_CARD_ID and for OBJECT_NAME='CalculationCardComponents'
    equals PAY_DIR_CARD_COMPONENTS_F.DIR_CARD_COMP_ID (both real base-table PKs).

    RECORD_KEY = SOURCE_SYSTEM_ID = exactly the value written into CalculationCard.dat
    as SourceSystemId and stamped on the TFM row as RECON_KEY (one key definition per
    object). SOURCE_REF echoes the same SourceSystemId; DMT_REFERENCE is null.

    Nine Contract v1 columns in order:
      OBJECT_TYPE, RECORD_KEY, SOURCE_TYPE, FUSION_STATUS, FUSION_ID,
      ERROR_MESSAGE, LOAD_REQUEST_ID, SOURCE_REF, DMT_REFERENCE.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base table for an
    HDL load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="tax_card_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id, source_ref, dmt_reference
FROM (
    -- BASE tier: positive proof that the HDL loader recorded each migrated
    -- calculation-card object in HRC_INTEGRATION_KEY_MAP under SOURCE_SYSTEM_OWNER
    -- 'HRC_SQLLOADER', whose SURROGATE_ID is the real Fusion base-table PK
    -- (PAY_DIR_CARDS_F.DIR_CARD_ID for CalculationCard,
    --  PAY_DIR_CARD_COMPONENTS_F.DIR_CARD_COMP_ID for CalculationCardComponents).
    -- OBJECT_TYPE carries the tier so multi-component cards reconcile per component.
    SELECT m.object_name                   AS object_type,
           m.source_system_id              AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(m.surrogate_id)             AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id,
           m.source_system_id              AS source_ref,
           CAST(NULL AS VARCHAR2(4000))    AS dmt_reference
    FROM   hrc_integration_key_map m
    WHERE  m.object_name IN ('CalculationCard', 'CalculationCardComponents')
    AND    m.source_system_owner = 'HRC_SQLLOADER'
    AND    m.source_system_id LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR m.source_system_id > :P_AFTER_KEY)
    GROUP BY m.object_name, m.source_system_id
    ORDER BY m.source_system_id
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="tax_card_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
