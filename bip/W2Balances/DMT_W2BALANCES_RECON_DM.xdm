<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_W2BALANCES_RECON_DM — Contract v1 reconciliation data model for W2Balances
    (design section 5, "BIP reconciliation report contract - v1").

    CORRECTED MODEL (2026-09-17): W2Balances loads through the HCM Data Loader as the
    "Balance Initialization" business object, which is TWO HDL objects in one zip —
    InitializeBalanceBatchHeader (-> InitializeBalanceBatchHeader.dat) and
    InitializeBalanceBatchLine (-> InitializeBalanceBatchLine.dat). One run = ONE
    batch; the header carries the batch (BatchName|UploadDate|LegislativeDataGroup-
    Name) and every line references it by BatchName. A "Load Initial Balances"
    (Transfer Batch) payroll flow is then run in Fusion to apply the staged batch.
    (This replaces the outdated PayrollBalanceInitialization.dat model, which Fusion
    rejects.)

    Returns the BASE tier: one row per migrated balance-initialization batch that is
    positively confirmed in the Fusion payroll balance base table
    PAY_BAL_BATCH_HEADERS, with its real Fusion BATCH_ID as FUSION_ID. This report
    proves the batch header — the unit reconciled to LOADED is the W2Balances
    (InitializeBalanceBatchHeader) TFM row.

    The match is made directly on PAY_BAL_BATCH_HEADERS.BATCH_NAME, which IS the
    business key we control: BatchName = <run prefix> || '_W2BAL' (the generator's
    BatchName, stamped on the W2Balances TFM row as RECON_KEY). Balance-initialization
    batch objects are keyed by BatchName (a user key), not by a person SourceSystemId,
    so matching by BATCH_NAME is both correct and robust. BATCH_ID is the base id.
    Verified live 2026-09-16/17 (cred fin_impl): PAY_BAL_BATCH_HEADERS.BATCH_NAME is
    directly queryable (e.g. batch_name LIKE 'DMT%' returns the DMT batches with their
    BATCH_ID), and HRC_INTEGRATION_KEY_MAP has InitializeBalanceBatchHeader (7 keys)
    and InitializeBalanceBatchLine (13 keys), confirming the object names on this pod.

    HDL failures arrive per-record in the HDL response (tagged [FUSION_ERROR] by
    RECONCILE_HDL before this report runs), so this report's ERROR rows are optional
    and it returns the BASE tier only — the W2Balances reconciler (which fetches
    these rows via DMT_RECON_CONTRACT_PKG.FETCH_ROWS and applies them statically)
    promotes a W2Balances TFM row to LOADED only from a BASE / SUCCESS /
    FUSION_ID-not-null row here.

    RECORD_KEY = PAY_BAL_BATCH_HEADERS.BATCH_NAME = the run's BatchName
    (<prefix>_W2BAL) = the W2Balances TFM row's RECON_KEY.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base table for an
    HDL load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="w2balances_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id
FROM (
    -- BASE tier: positive proof in the Fusion payroll balance base table
    -- PAY_BAL_BATCH_HEADERS, matched directly on BATCH_NAME (the business key we
    -- control): BatchName = <prefix>_W2BAL. One row per migrated balance batch.
    SELECT 'W2Balances'                    AS object_type,
           h.batch_name                    AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(h.batch_id)                 AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id
    FROM   pay_bal_batch_headers   h
    WHERE  h.batch_name LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR h.batch_name > :P_AFTER_KEY)
    GROUP BY h.batch_name
    ORDER BY h.batch_name
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="w2balances_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
