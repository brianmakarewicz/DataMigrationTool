<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_W2BALANCES_RECON_DM — Contract v1 reconciliation data model for W2Balances
    (design section 5, "BIP reconciliation report contract - v1").

    Returns the BASE tier for the W2Balances HDL load: one row per migrated
    balance-initialization batch that is positively confirmed in the Fusion payroll
    balance base table PAY_BAL_BATCH_HEADERS, with its real Fusion BATCH_ID as
    FUSION_ID. W2Balances loads through the HCM Data Loader as the
    PayrollBalanceInitialization business object: the parent BalanceInitialization
    record loads as the InitializeBalanceBatchHeader HDL object, which lands as one
    row in PAY_BAL_BATCH_HEADERS (BATCH_ID is the base id); the child
    BalInitializationDetails records load as InitializeBalanceBatchLine, landing in
    PAY_BAL_BATCH_LINES. This report proves the parent (the batch header) only — the
    unit reconciled to LOADED is the BalanceInitialization TFM row.

    The base table PAY_BAL_BATCH_HEADERS carries no business key we control, so the
    match is made through HRC_INTEGRATION_KEY_MAP: an HDL-loaded header appears there
    as OBJECT_NAME = 'InitializeBalanceBatchHeader' with SOURCE_SYSTEM_OWNER =
    'HRC_SQLLOADER' (the .dat SourceSystemOwner) and SOURCE_SYSTEM_ID = the .dat
    SourceSystemId; SURROGATE_ID = the base BATCH_ID. The join
    (map.surrogate_id = header.batch_id) was verified live 2026-09-16 with
    --cred fin_impl.

    HDL failures arrive per-record in the HDL response (tagged [FUSION_ERROR] by
    RECONCILE_HDL before this report runs), so this report's ERROR rows are optional
    and it returns the BASE tier only — the W2Balances reconciler (which fetches
    these rows via DMT_RECON_CONTRACT_PKG.FETCH_ROWS and applies them statically)
    promotes a BalanceInitialization TFM row to LOADED only from a BASE / SUCCESS /
    FUSION_ID-not-null row here.

    RECORD_KEY = the balance-initialization batch's business key = the prefixed
    SourceSystemId = the prefixed PERSON_NUMBER with the '_BAL' suffix, which is
    stamped on the W2Balances TFM row as RECON_KEY (DMT_UTIL_PKG.PREFIXED(prefix,
    PERSON_NUMBER, 30) || '_BAL' at transform — one key definition per object; see
    DMT_W2_BAL_HDL_GEN_PKG, where SourceSystemId = PERSON_NUMBER || '_BAL'). Matching
    is on HRC_INTEGRATION_KEY_MAP.SOURCE_SYSTEM_ID, which carries that same prefixed
    key once loaded.

    Live probe 2026-09-16 (--cred fin_impl): the demo instance has 7
    InitializeBalanceBatchHeader keys, all SOURCE_SYSTEM_OWNER='FUSION' (prior UI/test
    data), zero SOURCE_SYSTEM_OWNER<>'FUSION' — i.e. no record has yet been migrated
    through this SourceSystemId path, so there is no live base-data proof for a DMT
    prefix today. W2Balances is upstream-blocked; the report shape is proven but
    returns zero rows until a real DMT HDL load lands (honest: zero rows is never
    LOADED, per the reconciler's no-rows policy).

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base table for an
    HDL load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="w2balances_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id
FROM (
    -- BASE tier: positive proof in the Fusion payroll balance base table
    -- PAY_BAL_BATCH_HEADERS, matched to our HDL SourceSystemId through
    -- HRC_INTEGRATION_KEY_MAP. One row per migrated balance-initialization batch.
    SELECT 'W2Balances'                    AS object_type,
           m.source_system_id              AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(h.batch_id)                 AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id
    FROM   hrc_integration_key_map m
    JOIN   pay_bal_batch_headers   h ON h.batch_id = m.surrogate_id
    WHERE  m.object_name         = 'InitializeBalanceBatchHeader'
    AND    m.source_system_owner = 'HRC_SQLLOADER'
    AND    m.source_system_id LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR m.source_system_id > :P_AFTER_KEY)
    GROUP BY m.source_system_id
    ORDER BY m.source_system_id
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="w2balances_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
