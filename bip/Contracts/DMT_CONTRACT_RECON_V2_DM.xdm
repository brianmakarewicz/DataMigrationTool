<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="contract_po_recon_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- ============================================================
-- Contracts BIP reconciliation query -- BIP reconciliation
-- report contract v1 (nine columns, keyset pagination), V2.
-- Data source: ApplicationDB_FSCM. The repo mirror of this SQL is
-- bip/Contracts/query.sql.
-- V2 (2026-10-07) is deployed ALONGSIDE DMT_CONTRACT_RECON_DM
-- (V1); BIP objects are never overwritten.
--
-- NINE columns, in contract order:
--   OBJECT_TYPE, RECORD_KEY, SOURCE_TYPE, FUSION_STATUS,
--   FUSION_ID, ERROR_MESSAGE, LOAD_REQUEST_ID, SOURCE_REF,
--   DMT_REFERENCE
--
-- SIX parameters: P_RUN_ID, P_LOAD_REQUEST_ID, P_IMPORT_ESS_ID,
--   P_PREFIX, P_CHUNK_SIZE, P_AFTER_KEY. No P_OFFSET / P_LIMIT.
--
-- One tier (the Contract Purchase Agreement FBDI carries headers
-- only): OBJECT_TYPE 'Contracts'.
--
-- Row selection (owner decision 2026-10-07, backlog #259): rows
-- are FOUND only by the Fusion job ids of ONE work item (one load =
-- one Import Contract Agreements run), and by the document style,
-- because Contracts shares the PO interface and base tables with
-- PurchaseOrders and BlanketPOs.
--   BASE headers: REQUEST_ID = :P_IMPORT_ESS_ID AND
--     TYPE_LOOKUP_CODE = 'CONTRACT'.
--   INTERFACE headers: LOAD_REQUEST_ID = :P_LOAD_REQUEST_ID AND
--     REQUEST_ID = :P_IMPORT_ESS_ID AND DOCUMENT_TYPE_CODE =
--     'CONTRACT'.
--   PO_INTERFACE_ERRORS: REQUEST_ID = :P_IMPORT_ESS_ID, joined on
--     the numeric INTERFACE_HEADER_ID.
-- The run prefix and run id are never used to select rows (no LIKE
-- anywhere). P_RUN_ID and P_PREFIX are declared for contract
-- symmetry only. The document number is used only as RECORD_KEY,
-- to match a row Fusion returned back to its TFM row.
--
-- The INTERFACE tier returns rejections only (PROCESS_CODE <>
-- 'ACCEPTED'); accepted rows are covered by the BASE tier.
--
-- RECORD_KEY = the header TFM RECON_KEY (prefixed DOCUMENT_NUM =
-- base SEGMENT1, stamped by DMT_PO_TRANSFORM_PKG). Keyset: ORDER BY
-- RECORD_KEY (pinned to BINARY so the ordering and the >
-- comparison agree), only rows whose RECORD_KEY sorts after
-- :P_AFTER_KEY, at most :P_CHUNK_SIZE per page.
--
-- FUSION_STATUS normalized: BASE => SUCCESS, INTERFACE => ERROR.
-- FUSION_ID non-null on every BASE row; ERROR_MESSAGE is the real
-- Fusion text from PO_INTERFACE_ERRORS for the header, or NULL (the
-- reconciler leaves such a row for the UNACCOUNTED sweep).
-- ============================================================
SELECT
    object_type, record_key, source_type, fusion_status,
    fusion_id, error_message, load_request_id, source_ref, dmt_reference
FROM (
    -- BASE / headers -- found by the import job's REQUEST_ID, Contract style.
    SELECT
        'Contracts'                          AS object_type,
        h.segment1                           AS record_key,
        'BASE'                               AS source_type,
        'SUCCESS'                            AS fusion_status,
        h.po_header_id                       AS fusion_id,
        CAST(NULL AS VARCHAR2(4000))         AS error_message,
        h.request_id                         AS load_request_id,
        h.segment1                           AS source_ref,
        h.interface_source_code              AS dmt_reference
    FROM   po_headers_all h
    WHERE  h.request_id       = TO_NUMBER(:P_IMPORT_ESS_ID)
    AND    h.type_lookup_code = 'CONTRACT'

    UNION ALL

    -- INTERFACE / headers -- found by the load and import job ids,
    -- Contract style. Error = PO_INTERFACE_ERRORS rows of the import
    -- job on this header that carry no deeper interface id.
    SELECT
        'Contracts'                          AS object_type,
        h.document_num                       AS record_key,
        'INTERFACE'                          AS source_type,
        'ERROR'                              AS fusion_status,
        CAST(NULL AS NUMBER)                 AS fusion_id,
        CASE WHEN he.error_message IS NOT NULL
             THEN '[HDR] ' || he.error_message END
                                             AS error_message,
        h.load_request_id                    AS load_request_id,
        h.interface_header_key               AS source_ref,
        h.interface_source_code              AS dmt_reference
    FROM   po_headers_interface h
    LEFT   JOIN (
        SELECT e.interface_header_id,
               NULLIF(LISTAGG(
                   e.column_name || ': ' || e.error_message,
                   ' | ') WITHIN GROUP (ORDER BY e.interface_transaction_id), '') AS error_message
        FROM   po_interface_errors e
        WHERE  e.request_id = TO_NUMBER(:P_IMPORT_ESS_ID)
        AND    e.interface_header_id IS NOT NULL
        AND    e.interface_line_id   IS NULL
        AND    e.interface_line_location_id IS NULL
        AND    e.interface_distribution_id  IS NULL
        GROUP BY e.interface_header_id
    ) he ON he.interface_header_id = h.interface_header_id
    WHERE  h.load_request_id    = TO_NUMBER(:P_LOAD_REQUEST_ID)
    AND    h.request_id         = TO_NUMBER(:P_IMPORT_ESS_ID)
    AND    h.document_type_code = 'CONTRACT'
    AND    NVL(h.process_code,'X') <> 'ACCEPTED'
)
-- Keyset predicate. An empty P_AFTER_KEY (first page) binds to NULL
-- in BIP, so NULL means "from the start". The ordering and the
-- comparison are both pinned to BINARY so they agree.
WHERE  (:P_AFTER_KEY IS NULL
        OR NLSSORT(record_key, 'NLS_SORT=BINARY') > NLSSORT(:P_AFTER_KEY, 'NLS_SORT=BINARY'))
ORDER BY NLSSORT(record_key, 'NLS_SORT=BINARY')
FETCH FIRST :P_CHUNK_SIZE ROWS ONLY
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="contract_po_recon_results">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:integer" tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="1"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="1"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="1"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="1"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="1"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
