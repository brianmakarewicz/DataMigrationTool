<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="billing_event_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- ============================================================
-- BillingEvents (project billing) reconciliation data model --
-- BIP reconciliation report contract v1 (nine columns, keyset
-- pagination, the six standard parameters). Same shape as
-- DMT_EXP_RECON_DM.xdm and the other Contract-v1 reports.
--
-- NINE response columns, in contract order:
--   OBJECT_TYPE, RECORD_KEY, SOURCE_TYPE, FUSION_STATUS,
--   FUSION_ID, ERROR_MESSAGE, LOAD_REQUEST_ID, SOURCE_REF,
--   DMT_REFERENCE.
--
-- SIX parameters (Contract v1): P_RUN_ID, P_LOAD_REQUEST_ID,
--   P_IMPORT_ESS_ID, P_PREFIX, P_CHUNK_SIZE, P_AFTER_KEY.
--   (P_BATCH_ID is retired.) No P_OFFSET / P_LIMIT.
--
-- KEYSET pagination: rows are ordered by RECORD_KEY and only rows
-- whose RECORD_KEY sorts AFTER :P_AFTER_KEY are returned, at most
-- :P_CHUNK_SIZE of them. The reconciler's shared fetch loop calls
-- with an empty cursor first, then passes the last RECORD_KEY it
-- received on each next call, until a page returns fewer than
-- P_CHUNK_SIZE rows. An empty :P_AFTER_KEY (bound as NULL in BIP)
-- selects from the start (every non-null RECORD_KEY sorts after it).
--
-- OBJECT MODEL. BillingEvents is ONE object -- one FBDI zip
-- (PjbBillEventsInterface), one interface table
-- (PJB_BILLING_EVENTS_INT), one base table (PJB_BILLING_EVENTS),
-- loaded by the ImportBillingEventJob ESS job. So this DM is two
-- tiers (BASE + INTERFACE); OBJECT_TYPE is the constant
-- 'BillingEvents' (single record type).
--
-- RECON KEY = SOURCEREF (Slot A, the object's native source
-- reference). The transform stamps the run prefix onto it (e.g.
-- 10001RT-BE-G1) and that prefixed value survives verbatim onto the
-- base row's SOURCEREF, so it is BOTH the read-back recon key and
-- the run-scoped selector -- exactly the role ORIG_TRANSACTION_REFERENCE
-- plays in the Expenditures DM.
--
-- Row selection (proven live -- prefix 10001):
--   BASE rows:      PJB_BILLING_EVENTS where SOURCEREF LIKE
--       :P_PREFIX || '%'. FUSION_ID = EVENT_ID (verified live:
--       prefix 10001 -> 10001RT-BE-G1 = 100002632620075,
--       10001RT-BE-G2 = 100002632620081). REQUEST_ID is present on
--       the base row on this pod but is not the durable run selector
--       across objects, so the prefix is used; the base REQUEST_ID
--       is returned as LOAD_REQUEST_ID for audit.
--   INTERFACE rows: PJB_BILLING_EVENTS_INT for this run's load
--       request id (:P_LOAD_REQUEST_ID) that did NOT process
--       (IMPORT_STATUS is not a success value). SPECIAL / no-carrier
--       case: this interface table is ALWAYS purged after
--       ImportBillingEventJob completes (MOS 2534525.1), so in
--       practice the INTERFACE tier returns zero rows -- it is kept
--       for the rare pre-purge reconciliation and for contract
--       symmetry. SUCCESS billing events are proven only by the BASE
--       tier.
--
-- FUSION_STATUS is normalized in this DM to exactly SUCCESS/ERROR:
--   BASE  (row present in PJB_BILLING_EVENTS)               => SUCCESS
--   INTERFACE (unpurged, unprocessed row still in interface) => ERROR
-- FUSION_ID is non-null on every BASE/SUCCESS row (EVENT_ID).
--
-- ERROR_MESSAGE -- SPECIAL / no per-row carrier. The interface table
-- PJB_BILLING_EVENTS_INT has NO error-text column (verified: no
-- %MSG%/%ERR%/%DETAIL% column), and it is purged after import anyway.
-- The authoritative per-row rejection text lives in the
-- ImportBillingEventReportJob ESS output XML, not in any queryable
-- table. Per Contract v1, an INTERFACE/ERROR row therefore returns
-- the literal marker #IMPORT_REPORT#, which tells the reconciler to
-- invoke its import-report fallback (Tier 3) to obtain the real
-- Fusion message rather than fabricating one here.
-- ============================================================
SELECT
    object_type, record_key, source_type, fusion_status,
    fusion_id, error_message, load_request_id, source_ref, dmt_reference
FROM (
    -- ========== BASE tier: positive proof (SUCCESS) ==========
    -- One row per billing event that reached the base table for this
    -- run's prefix. RECORD_KEY / SOURCE_REF = SOURCEREF (the prefixed
    -- native reference, persisted verbatim on the base row).
    -- DMT_REFERENCE = ATTRIBUTE1 (the DFF slot; NULL until the DFF
    -- segment is deployed -- honest NULL, verified NULL live, not
    -- fabricated).
    SELECT
        'BillingEvents'                      AS object_type,
        be.sourceref                         AS record_key,
        'BASE'                               AS source_type,
        'SUCCESS'                            AS fusion_status,
        be.event_id                          AS fusion_id,
        CAST(NULL AS VARCHAR2(4000))         AS error_message,
        be.request_id                        AS load_request_id,
        be.sourceref                         AS source_ref,
        be.attribute1                        AS dmt_reference
    FROM   pjb_billing_events be
    WHERE  :P_PREFIX IS NOT NULL
    AND    be.sourceref LIKE :P_PREFIX || '%'

    UNION ALL

    -- ========== INTERFACE tier: rejections only (ERROR) ==========
    -- Interface rows for this load request that did not process
    -- (IMPORT_STATUS not a success value). This table is normally
    -- purged after import, so this tier usually returns zero rows;
    -- SUCCESS is proven by the BASE tier, so filtering to non-success
    -- here means no row is counted twice. RECORD_KEY / SOURCE_REF =
    -- SOURCEREF. ERROR_MESSAGE = #IMPORT_REPORT# marker: the interface
    -- carries no error text, so the reconciler harvests the real
    -- Fusion message from the ImportBillingEventReportJob XML.
    SELECT
        'BillingEvents'                      AS object_type,
        b.sourceref                          AS record_key,
        'INTERFACE'                          AS source_type,
        'ERROR'                              AS fusion_status,
        CAST(NULL AS NUMBER)                 AS fusion_id,
        '#IMPORT_REPORT#'                    AS error_message,
        b.load_request_id                    AS load_request_id,
        b.sourceref                          AS source_ref,
        b.attribute1                         AS dmt_reference
    FROM   pjb_billing_events_int b
    WHERE  b.load_request_id = TO_NUMBER(:P_LOAD_REQUEST_ID)
    AND    NVL(UPPER(b.import_status),'X')
             NOT IN ('COMPLETE','COMPLETED','IMPORTED','Y','PROCESSED','SUCCESS','P')
)
-- Keyset predicate. An empty P_AFTER_KEY (first page) binds to NULL in
-- BIP, so treat NULL as "from the start": return every row. On later
-- pages P_AFTER_KEY carries the previous page's last RECORD_KEY and only
-- greater keys are returned. RECORD_KEY is compared as text (the recon
-- key is a string); the reconciler feeds back the exact key it received.
WHERE  (:P_AFTER_KEY IS NULL OR record_key > :P_AFTER_KEY)
ORDER BY record_key
FETCH FIRST :P_CHUNK_SIZE ROWS ONLY
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="billing_event_results">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:integer" tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="1"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="1"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="1"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <!-- Keyset pagination: page size + cursor. The reconciler calls
         with an empty P_AFTER_KEY first, then passes the last RECORD_KEY
         received on each next call, until a short page returns. -->
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="1"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="1"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
