<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_BENPARTICIPANT_RECON_DM — Contract v1 reconciliation data model for
    BenParticipant (design section 5, "BIP reconciliation report contract - v1").

    BenParticipant loads through HCM Data Loader as the ParticipantEnrollment
    business object (DAT discriminator ParticipantEnrollment; see
    DMT_BEN_PARTIC_HDL_GEN_PKG) — NOT PersonBenefitBalance. An HDL load has no
    interface table, so this report returns the BASE tier only: one row per
    migrated worker whose benefit participant enrollment Fusion positively
    confirmed in the enrollment base table BEN_PRTT_ENRT_RSLT, with the real
    Fusion PRTT_ENRT_RSLT_ID as FUSION_ID.

    ParticipantEnrollment is create-only and carries NO SourceSystemId, so it
    does NOT register a row in HRC_INTEGRATION_KEY_MAP (confirmed absent on the
    pod). Reconciliation therefore reads the enrollment base table directly,
    joined to PER_ALL_PEOPLE_F by the worker's PersonNumber — the same base-table
    shape the Workers reconciler uses (PER_ALL_PEOPLE_F.PERSON_NUMBER matched by
    prefix).

    RECORD_KEY = the prefixed PERSON_NUMBER = the PersonNumber written into
    ParticipantEnrollment.dat = the BenParticipant TFM row's RECON_KEY
    (DMT_BEN_PARTIC_HDL_GEN_PKG references the worker by PersonNumber, which is
    already prefixed on the TFM row). The BenParticipant reconciler fetches these
    rows via DMT_RECON_CONTRACT_PKG.FETCH_ROWS and applies them statically,
    promoting a BenParticipant TFM row to LOADED only from a
    BASE / SUCCESS / FUSION_ID-not-null row here and stamping FUSION_ID into
    FUSION_PARTICIPANT_ID.

    Verified live 2026-09-17 against the demo Fusion instance (fin_impl /
    ApplicationDB_FSCM):
      * Benefits IS configured on the pod: BEN_PGM_F = 24 programs,
        BEN_PRTT_ENRT_RSLT = 38,411 enrollment results, BEN_LER_F lists real
        life events including 'New Hire'.
      * 'ParticipantEnrollment' is absent from HRC_INTEGRATION_KEY_MAP
        (create-only object, no SourceSystemId), confirming the base-table
        approach is required.
      * BEN_PRTT_ENRT_RSLT and PER_ALL_PEOPLE_F are both reachable by name from
        the BIP reporting user; this exact SELECT (grouped by PERSON_NUMBER,
        MAX(PRTT_ENRT_RSLT_ID) as FUSION_ID) runs cleanly and returns real base
        rows (e.g. person 39 -> 337499).
      * With a test P_PREFIX it returns ZERO rows until our HDL loads
        enrollments — an honest zero-row result, not a broken query.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base for an HDL
    load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="benparticipant_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id
FROM (
    -- BASE tier: positive proof in the Fusion benefit enrollment base table.
    -- ParticipantEnrollment is create-only (no SourceSystemId / no integration
    -- key-map row), so match the base row by the worker's prefixed PersonNumber
    -- via PER_ALL_PEOPLE_F. FUSION_ID = the Fusion PRTT_ENRT_RSLT_ID. One row per
    -- migrated worker (MAX over that worker's enrollment results).
    SELECT 'BenParticipant'               AS object_type,
           p.person_number                AS record_key,
           'BASE'                         AS source_type,
           'SUCCESS'                      AS fusion_status,
           MAX(r.prtt_enrt_rslt_id)       AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))   AS error_message,
           :P_LOAD_REQUEST_ID             AS load_request_id
    FROM   ben_prtt_enrt_rslt r
    JOIN   per_all_people_f   p ON p.person_id = r.person_id
    WHERE  p.person_number LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR p.person_number > :P_AFTER_KEY)
    GROUP BY p.person_number
    ORDER BY p.person_number
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="benparticipant_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
