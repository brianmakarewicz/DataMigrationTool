<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_BENPARTICIPANT_RECON_DM - Contract v1 (nine-column) reconciliation data model
    for BenParticipant (design section 5, "BIP reconciliation report contract - v1").

    RE-POINTED 2026-09-22 to the CORRECT Fusion object. BenParticipant loads through the
    HCM Data Loader as the ParticipantEnrollment business object
    (ParticipantEnrollment.dat -- see db/packages/dmt_ben_partic_hdl_gen_pkg.pkb.sql).
    The prior model loaded/reconciled as PersonBenefitBalance (benefit BALANCES, not
    enrollments), which also collided on the file name PersonBenefitBalance.dat with the
    Dependent and Beneficiary generators. Corrected here.

    ORACLE DOC AUTHORITY:
      * HCM Data Loader benefits enrollment (participant enrollment) business object;
        Tables and Views for HCM reference for the base table.
      * Base table BEN_PRTT_ENRT_RSLT (oedmh): identifies the plans/options a participant
        is enrolled in; PRTT_ENRT_RSLT_ID is the primary key.
        https://docs.oracle.com/en/cloud/saas/human-resources/oedmh/benprttenrtrslt-4213.html

    BASE TABLE: BEN_PRTT_ENRT_RSLT (joined to PER_ALL_PEOPLE_F by PERSON_ID).
    FUSION_ID = PRTT_ENRT_RSLT_ID. ParticipantEnrollment is create-only and carries NO
    SourceSystemId, and there is NO HRC_INTEGRATION_KEY_MAP row for it, so base-tier
    matching is by the worker's prefixed PERSON_NUMBER against PER_ALL_PEOPLE_F; keyset
    pagination by RECORD_KEY (= the prefixed PERSON_NUMBER = the TFM row's RECON_KEY).

    LIVE PROBE (original PR, cred fin_impl): BEN_PRTT_ENRT_RSLT ~38,411 rows; both
    BEN_PRTT_ENRT_RSLT and PER_ALL_PEOPLE_F reachable by name; PRTT_ENRT_RSLT_ID returns
    as FUSION_ID (e.g. person 39 -> 337499). Re-probe at re-cut was environment-blocked
    (BIP credential 401); table existence/shape confirmed by the Oracle Tables/Views
    reference above and the original PR probe.

    THE NINE COLUMNS (design section 5, in order):
      1 OBJECT_TYPE     - 'BenParticipant'.
      2 RECORD_KEY      - PERSON_NUMBER (the prefixed worker number).
      3 SOURCE_TYPE     - 'BASE'.
      4 FUSION_STATUS   - 'SUCCESS' (BASE tier only; HDL per-record failures tagged
                          [FUSION_ERROR] by RECONCILE_HDL before this runs).
      5 FUSION_ID       - PRTT_ENRT_RSLT_ID, the real Fusion base-table PK.
      6 ERROR_MESSAGE   - NULL.
      7 LOAD_REQUEST_ID - :P_LOAD_REQUEST_ID echoed back for audit.
      8 SOURCE_REF      - the prefixed PERSON_NUMBER (= RECORD_KEY); the base table stores
                          no HDL SourceSystemId.
      9 DMT_REFERENCE   - DFF stamp; not deployed for this HDL load, so NULL.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="ben_partic_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id, source_ref, dmt_reference
FROM (
    -- BASE tier: positive proof in the Fusion benefit enrollment base table.
    -- ParticipantEnrollment is create-only (no SourceSystemId / no integration
    -- key-map row), so match the base row by the worker's prefixed PersonNumber
    -- via PER_ALL_PEOPLE_F. FUSION_ID = the Fusion PRTT_ENRT_RSLT_ID. One row per
    -- migrated worker (MAX over that worker's enrollment results).
    SELECT 'BenParticipant'               AS object_type,
           p.person_number                AS record_key,
           'BASE'                         AS source_type,
           'SUCCESS'                      AS fusion_status,
           MAX(r.prtt_enrt_rslt_id)       AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))   AS error_message,
           :P_LOAD_REQUEST_ID             AS load_request_id,
           p.person_number                AS source_ref,
           CAST(NULL AS VARCHAR2(4000))   AS dmt_reference
    FROM   ben_prtt_enrt_rslt r
    JOIN   per_all_people_f   p ON p.person_id = r.person_id
    WHERE  p.person_number LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR p.person_number > :P_AFTER_KEY)
    GROUP BY p.person_number
    ORDER BY p.person_number
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="ben_partic_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="1"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="1"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="1"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <!-- Keyset pagination: page size + cursor. The reconciler calls with an
         empty P_AFTER_KEY first, then passes the last RECORD_KEY received on
         each next call, until a short page returns. -->
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="1"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="1"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
