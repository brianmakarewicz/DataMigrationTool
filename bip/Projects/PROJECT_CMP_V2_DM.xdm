<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="project_cmp_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- Backlog #94. Independent scalar subqueries over dual, so the business-key
-- checksum can NEVER affect the count:
--
--   SUCCESS_COUNT -- the ORIGINAL, unchanged reconciliation count: projects
--     confirmed in PJF_PROJECTS_ALL_B for this run's captured project_id list.
--     Self-contained; a checksum problem cannot zero or break it.
--
--   KEY_CHECKSUM -- a deterministic, order-independent set-checksum over the
--     loaded Projects business key. The business key is PROJECT_NUMBER
--     (prefix-carrying, per DMT_DESIGN.html "PREFIX + PROJECT_NUMBER"), which
--     on the Fusion side is PJF_PROJECTS_ALL_B.SEGMENT1. VERIFIED LIVE on the
--     demo instance (fin_impl): SEGMENT1 = 93270RTPRJ001/002 for the captured
--     project_ids, matching the DMT TFM PROJECT_NUMBER byte-for-byte. Checksum
--     recipe, identical to the STG side in
--     DMT_PPM_COMPARE_PKG.GET_PROJECTS_CMP:
--       normalize    UPPER(TRIM(segment1))
--       per-key hash ORA_HASH(normalized)
--       set-combine  SUM over the DISTINCT normalized key set || ':' || COUNT.
--     NULL on an empty set via NVL, so it never errors the row.
SELECT (SELECT COUNT(*)
        FROM   pjf_projects_all_b
        WHERE  project_id IN (
                 SELECT TO_NUMBER(REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL))
                 FROM dual CONNECT BY REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL) IS NOT NULL
               ))                                           AS success_count,
       CAST(NULL AS NUMBER)                                 AS success_amount,
       CAST(NULL AS VARCHAR2(15))                           AS amount_currency,
       (SELECT TO_CHAR(NVL(SUM(ORA_HASH(k)),0)) || ':' || COUNT(*)
        FROM (
          SELECT DISTINCT UPPER(TRIM(p.segment1)) AS k
          FROM   pjf_projects_all_b p
          WHERE  p.project_id IN (
                   SELECT TO_NUMBER(REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL))
                   FROM dual CONNECT BY REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL) IS NOT NULL
                 )
        ))                                                  AS key_checksum
FROM   dual
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="project_cmp_results">
          <element name="SUCCESS_COUNT"    value="SUCCESS_COUNT"    dataType="xsd:string" tagName="SUCCESS_COUNT"/>
          <element name="SUCCESS_AMOUNT"   value="SUCCESS_AMOUNT"   dataType="xsd:string" tagName="SUCCESS_AMOUNT"/>
          <element name="AMOUNT_CURRENCY"  value="AMOUNT_CURRENCY"  dataType="xsd:string" tagName="AMOUNT_CURRENCY"/>
          <element name="KEY_CHECKSUM"     value="KEY_CHECKSUM"     dataType="xsd:string" tagName="KEY_CHECKSUM"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_BATCH_ID" dataType="character" rowPlacement="1"
               labelID="P_BATCH_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
