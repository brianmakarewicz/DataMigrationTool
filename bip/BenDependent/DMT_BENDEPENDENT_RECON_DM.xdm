<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_BENDEPENDENT_RECON_DM — Contract v1 reconciliation data model for
    BenDependent (design section 5, "BIP reconciliation report contract - v1").

    Returns the BASE tier for the BenDependent HDL load: one row per migrated
    dependent benefit balance that is positively confirmed in the Fusion HCM
    Benefits base table BEN_PER_BNFTS_BAL_F, with its real Fusion
    PER_BNFTS_BAL_ID as FUSION_ID. BenDependent loads through the HCM Data
    Loader as the PersonBenefitBalance object (PersonBenefitBalance.dat — the
    same discriminator all three benefit sub-objects share; the more specific
    DependentBenefitBalance is NOT a valid HDL discriminator, see
    DMT_BEN_DEPEND_HDL_GEN_PKG and objects/Benefits/README.md). HDL failures
    arrive per-record in the HDL response (tagged [FUSION_ERROR] by RECONCILE_HDL
    before this report runs), so this report's ERROR rows are optional and it
    returns the BASE tier only — the BenDependent reconciler (which fetches these
    rows via DMT_RECON_CONTRACT_PKG.FETCH_ROWS and applies them statically)
    promotes a BenDependent TFM row to LOADED only from a BASE / SUCCESS /
    FUSION_ID-not-null row here.

    RECORD_KEY = the dependent's business key = the prefixed PERSON_NUMBER ||
    '_BENDEP', which is exactly the value written into PersonBenefitBalance.dat
    as SourceSystemId (see DMT_BEN_DEPEND_HDL_GEN_PKG: pv(PERSON_NUMBER) ||
    '_BENDEP', where PERSON_NUMBER is already the run-prefixed person number) and
    stamped on the BenDependent TFM row as RECON_KEY (one key definition per
    object). The load records a mapping row in HRC_INTEGRATION_KEY_MAP keyed by
    that same SourceSystemId, whose SURROGATE_ID is the Fusion PER_BNFTS_BAL_ID.
    Matching joins that mapping row to the base table to guarantee FUSION_ID is a
    real base-table id, mirroring the Salaries report's key-map read.

    Verified live 2026-09-16 with --cred fin_impl:
      HRC_INTEGRATION_KEY_MAP.OBJECT_NAME='PersonBenefitBalance' has 838 rows;
      SURROGATE_ID == BEN_PER_BNFTS_BAL_F.PER_BNFTS_BAL_ID (join proven, PERSON_ID
      resolves), and the seven-column contract SQL below returns BASE/SUCCESS rows.
    Our own '_BENDEP' records are NOT present: employee benefit enrollment is not
    configured on the demo instance and the migrated test workers are not enrolled
    in any plan, so the load is rejected upstream (documented BLOCKER,
    objects/Benefits/README.md). The report is nonetheless correct and its shape is
    proven; it will return our rows once benefits enrollment is configured.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base table for an
    HDL load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="bendependent_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id
FROM (
    -- BASE tier: positive proof in the HCM Benefits base table. The load writes
    -- one HRC_INTEGRATION_KEY_MAP row per person benefit balance
    -- (OBJECT_NAME='PersonBenefitBalance') whose SURROGATE_ID is the
    -- BEN_PER_BNFTS_BAL_F.PER_BNFTS_BAL_ID. Joined to the base table so FUSION_ID
    -- is guaranteed a real base-table id. One row per migrated dependent balance.
    SELECT 'BenDependent'                  AS object_type,
           m.source_system_id              AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(b.per_bnfts_bal_id)         AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id
    FROM   hrc_integration_key_map m
    JOIN   ben_per_bnfts_bal_f b
           ON b.per_bnfts_bal_id = m.surrogate_id
    WHERE  m.object_name = 'PersonBenefitBalance'
    AND    m.source_system_id LIKE :P_PREFIX || '%'
    AND    m.source_system_id LIKE '%\_BENDEP' ESCAPE '\'
    AND    (:P_AFTER_KEY IS NULL OR m.source_system_id > :P_AFTER_KEY)
    GROUP BY m.source_system_id
    ORDER BY m.source_system_id
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="bendependent_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
