<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_BENDEPENDENT_RECON_DM — Contract v1 reconciliation data model for
    BenDependent (design section 5, "BIP reconciliation report contract - v1").

    CORRECTED OBJECT (2026-09-17): dependent benefit enrollment loads through the
    HCM Data Loader as the DependentEnrollment business object, whose dependent
    designations are carried by the DesignateDependent child component (written to
    DependentEnrollment.dat — see DMT_BEN_DEPEND_HDL_GEN_PKG). This is NOT
    PersonBenefitBalance; the prior model read PersonBenefitBalance /
    BEN_PER_BNFTS_BAL_F, which is the wrong object (and its file name collided
    with BenBeneficiary and BenParticipant). One migrated TFM row = one dependent
    designation = one DesignateDependent record.

    Returns the BASE tier: one row per migrated dependent designation positively
    confirmed by its HRC_INTEGRATION_KEY_MAP mapping row
    (OBJECT_NAME='DesignateDependent'), with the Fusion-assigned SURROGATE_ID as
    FUSION_ID. The benefit-election base tables are not reachable by name from the
    BIP reporting user (ORA-00942 on BEN_ELIG_DPNT_F and related), so
    HRC_INTEGRATION_KEY_MAP is the authoritative base-tier source — the same
    approach proven for BenParticipant and Salaries. HDL per-record failures are
    captured separately (RECONCILE_HDL tags [FUSION_ERROR] before this report
    runs), so this report returns BASE/SUCCESS rows only; the reconciler promotes
    a BenDependent TFM row to LOADED only from a BASE / SUCCESS / FUSION_ID-not-null
    row here.

    RECORD_KEY = the DesignateDependent SourceSystemId written by
    DMT_BEN_DEPEND_HDL_GEN_PKG:
      PERSON_NUMBER || '_' || DEPENDENT_PERSON_NUMBER || '_' || LINE_NO || '_BENDEP'
    (PERSON_NUMBER and DEPENDENT_PERSON_NUMBER already run-prefixed). This equals
    the BenDependent TFM row's RECON_KEY (one key definition per object). The load
    records a mapping row in HRC_INTEGRATION_KEY_MAP keyed by that SourceSystemId,
    whose SURROGATE_ID is the Fusion designation id.

    Verified live 2026-09-17 with the fin_impl credential:
      HRC_INTEGRATION_KEY_MAP carries ContactRelationship (397 rows — dependents
      are contact-relationship-based) and PersonBenefitBalance (838, a distinct
      object). DependentEnrollment / DesignateDependent rows are NOT present yet
      and the BEN_ELIG_DPNT_F base table is not reachable by name (ORA-00942),
      confirming the key-map read is the correct base-tier source. Our own records
      are absent because employee benefit enrollment is not configured on the demo
      instance (documented BLOCKER, objects/Benefits/README.md). The report is
      correct and its shape is proven; it returns our rows once benefits enrollment
      is configured and the load succeeds.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
    P_LOAD_REQUEST_ID / P_IMPORT_ESS_ID do not survive into the base table for an
    HDL load, so BASE-tier matching is by the run prefix (P_PREFIX). LOAD_REQUEST_ID
    is echoed back unchanged for audit.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="bendependent_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id
FROM (
    -- BASE tier: positive proof from the integration key map. The load writes one
    -- HRC_INTEGRATION_KEY_MAP row per dependent designation
    -- (OBJECT_NAME='DesignateDependent') whose SURROGATE_ID is the Fusion-assigned
    -- designation id. The benefit-election base tables are not reachable by name
    -- from the BIP reporting user, so the key map is the authoritative base-tier
    -- source. One row per migrated dependent designation.
    SELECT 'BenDependent'                  AS object_type,
           m.source_system_id              AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(m.surrogate_id)             AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id
    FROM   hrc_integration_key_map m
    WHERE  m.object_name = 'DesignateDependent'
    AND    m.source_system_id LIKE :P_PREFIX || '%'
    AND    m.source_system_id LIKE '%\_BENDEP' ESCAPE '\'
    AND    (:P_AFTER_KEY IS NULL OR m.source_system_id > :P_AFTER_KEY)
    GROUP BY m.source_system_id
    ORDER BY m.source_system_id
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="bendependent_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
