<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_PERFEVALUATIONS_RECON_DM - Contract v1 (nine-column) reconciliation data model
    for PerfEvaluations (design section 5, "BIP reconciliation report contract - v1").

    RE-POINTED 2026-09-22 to the CORRECT Fusion object. PerfEvaluations loads through
    the HCM Data Loader as the PerformanceDocument business object (PerfDocComplete.dat
    plus the RatingsAndComments component - see db/packages/dmt_perf_eval_hdl_gen_pkg.pkb.sql,
    BUILD_DAT_HEADER('PerfDocComplete',...)). A loaded performance evaluation therefore
    lives in Fusion as a performance document, NOT as a goal plan. (The prior model
    reconciled against the Goal Management view HRG_GOAL_PLANS_VL, the wrong object for
    a performance evaluation.)

    ORACLE DOC AUTHORITY:
      * HCM Data Loader - Performance Document business object (create/complete/cancel/
        delete performance documents; section ratings and comments):
        https://docs.oracle.com/en/cloud/saas/talent-management/faapd/hcm-data-loader-and-performance-document-business-objects.html
      * Base table HRA_EVALUATIONS (Tables and Views for HCM, oedmh): stores the
        performance document; EVALUATION_ID is the primary key; NAME is the document
        name. https://docs.oracle.com/en/cloud/saas/human-resources/oedmh/hraevaluations-5145.html

    BASE TABLE: HRA_EVALUATIONS. EVALUATION_ID is the base id (FUSION_ID); NAME is the
    document name (CustomaryName) and the RECORD_KEY. PerformanceDocument is a
    natural-key object (no SourceSystem keys, no HRC_INTEGRATION_KEY_MAP row), so
    base-tier matching is by the run prefix (P_PREFIX) against NAME; keyset pagination
    by RECORD_KEY.

    LIVE PROBE (original PR, cred fin_impl, 2026-09-17): HRA_EVALUATIONS exists with
    ~6773 rows; columns include EVALUATION_ID, NAME, WORKER_ID, ASSIGNMENT_ID,
    MANAGER_ID; templates + review periods configured on the pod. Re-probe was
    environment-blocked at re-cut (BIP credential 401); table existence and shape are
    confirmed by the Oracle Tables/Views reference above and the original PR probe.

    RECORD_KEY = the prefixed document name = HRA_EVALUATIONS.NAME = the PerfEvaluations
    TFM row's RECON_KEY (run prefix applied to DOCUMENT_NAME at transform, section 5).

    THE NINE COLUMNS (design section 5, in order):
      1 OBJECT_TYPE     - 'PerfEvaluations'.
      2 RECORD_KEY      - NAME (the prefixed document name / business key).
      3 SOURCE_TYPE     - 'BASE' (positive base-table proof).
      4 FUSION_STATUS   - 'SUCCESS' (BASE/SUCCESS tier only; HDL per-record failures are
                          tagged [FUSION_ERROR] by RECONCILE_HDL before this runs).
      5 FUSION_ID       - EVALUATION_ID, the real Fusion base-table PK.
      6 ERROR_MESSAGE   - NULL (no ERROR rows in a BASE-tier HDL report).
      7 LOAD_REQUEST_ID - :P_LOAD_REQUEST_ID echoed back unchanged for audit.
      8 SOURCE_REF      - Slot A native reference read back from the base table; the
                          prefixed NAME (= RECORD_KEY), as HRA_EVALUATIONS does not store
                          our HDL SourceSystemId.
      9 DMT_REFERENCE   - Slot C DFF stamp; not deployed for this HDL load, so NULL.

    Six Contract v1 parameters; keyset pagination by RECORD_KEY (P_AFTER_KEY).
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="perf_eval_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type, record_key, source_type, fusion_status,
       fusion_id, error_message, load_request_id, source_ref, dmt_reference
FROM (
    -- BASE tier: positive proof in the Performance Management document base table.
    -- One row per migrated performance document (GROUP BY name is defensive).
    SELECT 'PerfEvaluations'               AS object_type,
           v.name                          AS record_key,
           'BASE'                          AS source_type,
           'SUCCESS'                       AS fusion_status,
           MAX(v.evaluation_id)            AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))    AS error_message,
           :P_LOAD_REQUEST_ID              AS load_request_id,
           v.name                          AS source_ref,
           CAST(NULL AS VARCHAR2(4000))    AS dmt_reference
    FROM   hra_evaluations v
    WHERE  v.name LIKE :P_PREFIX || '%'
    AND    (:P_AFTER_KEY IS NULL OR v.name > :P_AFTER_KEY)
    GROUP BY v.name
    ORDER BY v.name
)
WHERE ROWNUM <= :P_CHUNK_SIZE
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="perf_eval_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:integer" tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
