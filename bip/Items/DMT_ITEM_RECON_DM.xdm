<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <!--
    DMT_ITEM_RECON_DM : Contract v1 reconciliation data model for Items (FBDI).
    See docs/DMT_DESIGN.html section 5 ("BIP reconciliation report contract v1").

    TWO RECORD TYPES IN ONE OBJECT
    Items is a single pipeline object (db/seed/dmt_cemli_catalog_tbl.sql: 'Items'
    covers both 'Item Master' -> DMT_EGP_ITEM_TFM_TBL and 'Item Categories' ->
    DMT_EGP_ITEM_CAT_TFM_TBL). Its one FBDI zip carries two CSVs loaded under one
    ESS job. So this ONE report emits BOTH record types, discriminated by
    OBJECT_TYPE:
      OBJECT_TYPE='Item'         -> item master, keyed ITEM_NUMBER~ORGANIZATION_CODE
      OBJECT_TYPE='ItemCategory' -> item category assignment, keyed
                                    ITEM_NUMBER~ORGANIZATION_CODE~CATEGORY_SET_NAME~CATEGORY_CODE
    The reconciler applies each tier to its own TFM table statically, matching
    RECON_KEY = RECORD_KEY (see DMT_EGP_ITEM_RESULTS_PKG.APPLY_CONTRACT_V1_ITEMS
    and the RECON_KEY stamps in DMT_EGP_ITEM_TRANSFORM_PKG /
    DMT_EGP_ITEM_CAT_TRANSFORM_PKG).

    RECORD_KEY alignment (one RECON_KEY per TFM row)
    ITEM_NUMBER in the Fusion interface/base rows carries the run-prefixed value
    (the FBDI generator wrote the prefixed number), which is exactly what the TFM
    tables store. So the INTERFACE and BASE tiers below build RECORD_KEY from the
    same columns the transform used to stamp RECON_KEY (byte-for-byte identical).
    The '~' delimiter never appears in item numbers, org codes, category set names,
    or category codes (verified against the local corpus).

    TIER RULES (Contract v1)
      INTERFACE tier : one row per interface record whose base row is ABSENT,
                       i.e. a rejection. Per the binding Contract v1 rule
                       (docs/DMT_DESIGN.html section 5), FUSION_STATUS is
                       normalized in this DM to exactly 'ERROR' and ERROR_MESSAGE
                       is non-null, carrying the REAL Fusion rejection text
                       harvested from EGP_IMPORT_ERRORS.MESSAGE_TEXT (keyed on
                       TRANSACTION_ID, filtered by ERROR_TABLE_NAME). Items records
                       per-row error text there, so it does NOT use the
                       #IMPORT_REPORT# marker. A short fallback string is used only
                       when Fusion left no error row for a rejected item, so the
                       reconciler can still mark it FAILED (never UNACCOUNTED).
                       The reconciler marks these rows FAILED with
                       '[FUSION_ERROR] ' || ERROR_MESSAGE.
      BASE tier      : one row per record positively present in its Fusion base
                       table (EGP_SYSTEM_ITEMS_B for items,
                       EGP_ITEM_CATEGORIES for categories). SOURCE_TYPE='BASE',
                       FUSION_STATUS='SUCCESS', FUSION_ID = the base primary key
                       (INVENTORY_ITEM_ID / ITEM_CATEGORY_ASSIGNMENT_ID). This is
                       the ONLY path to LOADED. INTERFACE (rejection) and BASE
                       (present) tiers are mutually exclusive on base presence, so
                       no record is counted twice.

    NINE COLUMNS (Contract v1 order); SIX parameters; keyset by RECORD_KEY.
    RUN SCOPING IS BY P_PREFIX, NOT BY A SINGLE LOAD REQUEST ID. The run prefix is
    embedded at the front of every ITEM_NUMBER and survives to the interface and
    base tables, so P_PREFIX selects every record of this run regardless of how
    many InterfaceLoaderController requests Fusion chunked the load into. This is
    deliberate: a single P_LOAD_REQUEST_ID would see only one chunk and leave the
    other chunks' genuinely-loaded/rejected rows unaccounted (docs/DMT_DESIGN.html
    section 5 calls out P_PREFIX for base-table matching where no single request id
    survives). P_LOAD_REQUEST_ID is still bound (stamped into LOAD_REQUEST_ID for
    traceability) but is NOT used to filter rows.
  -->
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="items_recon" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
SELECT object_type,
       record_key,
       source_type,
       fusion_status,
       fusion_id,
       error_message,
       load_request_id,
       source_ref,
       dmt_reference
FROM (
    -- ---- Item master, INTERFACE tier (rejections carry real Fusion text) -----
    -- An interface row whose base row is ABSENT is a rejection. Contract v1
    -- requires FUSION_STATUS normalized to ERROR and a non-null ERROR_MESSAGE
    -- carrying the real Fusion rejection text, harvested from EGP_IMPORT_ERRORS
    -- (keyed on TRANSACTION_ID). Items records per-row error text there, so this
    -- object does NOT use the #IMPORT_REPORT# marker. A short fallback string is
    -- used only when Fusion left no error row for a rejected item, so the row
    -- still reaches FAILED (never UNACCOUNTED) per THE MISSION.
    SELECT 'Item'                                          AS object_type,
           i.item_number || '~' || i.organization_code     AS record_key,
           'INTERFACE'                                     AS source_type,
           'ERROR'                                         AS fusion_status,
           -- VARCHAR2 to match the BASE tier's composite fusion_id: BIP derives
           -- one datatype per UNION column, so every branch's fusion_id must be
           -- the same type or the report data model 500s at runtime.
           CAST(NULL AS VARCHAR2(100))                     AS fusion_id,
           '[ITEM] ' || NVL(ie.error_message,
               'Rejected by Item Import (process_status='
               || NVL(TO_CHAR(i.process_status), 'NULL')
               || '; item not created in base table EGP_SYSTEM_ITEMS_B).')
                                                           AS error_message,
           TO_CHAR(i.load_request_id)                      AS load_request_id,
           i.item_number                                   AS source_ref,
           CAST(NULL AS VARCHAR2(240))                     AS dmt_reference
    FROM   egp_system_items_interface i
    LEFT   JOIN egp_system_items_b b
           ON b.item_number     = i.item_number
          AND b.organization_id = i.organization_id
    LEFT   JOIN (
        -- Real Fusion error text per interface row, keyed on TRANSACTION_ID.
        -- One transaction can raise several messages; collapse them into one
        -- string, prefixed with the errored column name when Fusion records one.
        SELECT e.transaction_id,
               LISTAGG(
                   CASE WHEN e.error_column_name IS NOT NULL
                        THEN e.error_column_name || ': ' || e.message_text
                        ELSE e.message_text END,
                   ' | ') WITHIN GROUP (ORDER BY e.error_id) AS error_message
        FROM   egp_import_errors e
        WHERE  e.transaction_id > 0
        AND    e.error_table_name = 'EGP_SYSTEM_ITEMS_INTERFACE'
        GROUP BY e.transaction_id
    ) ie ON ie.transaction_id = i.transaction_id
    WHERE  :P_PREFIX IS NOT NULL
    AND    i.item_number LIKE :P_PREFIX || '%'
    AND    i.organization_code IS NOT NULL
    AND    b.item_number IS NULL

    UNION ALL

    -- ---- Item master, BASE tier (positive proof -> LOADED) ------------------
    -- FUSION_ID is the per-org composite INVENTORY_ITEM_ID~ORGANIZATION_ID from
    -- EGP_SYSTEM_ITEMS_B: an inventory item is loaded PER ORGANIZATION, so its
    -- real identity in the base table is the pair (INVENTORY_ITEM_ID,
    -- ORGANIZATION_ID). The item id alone dropped the org, so two rows for the
    -- same item in different orgs collided. Per-item-per-org grain is preserved
    -- (RECORD_KEY = ITEM_NUMBER~ORGANIZATION_CODE, one row per org). The '~'
    -- composite rides the shared Contract v1 string FUSION_ID (widened in #456).
    SELECT 'Item'                                          AS object_type,
           i.item_number || '~' || i.organization_code     AS record_key,
           'BASE'                                          AS source_type,
           'SUCCESS'                                       AS fusion_status,
           TO_CHAR(b.inventory_item_id) || '~'
             || TO_CHAR(b.organization_id)                 AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))                    AS error_message,
           TO_CHAR(i.load_request_id)                      AS load_request_id,
           i.item_number                                   AS source_ref,
           CAST(NULL AS VARCHAR2(240))                     AS dmt_reference
    FROM   egp_system_items_interface i
    JOIN   egp_system_items_b b
           ON b.item_number     = i.item_number
          AND b.organization_id = i.organization_id
    WHERE  :P_PREFIX IS NOT NULL
    AND    i.item_number LIKE :P_PREFIX || '%'
    AND    i.organization_code IS NOT NULL

    UNION ALL

    -- ---- Item category, INTERFACE tier (rejections carry real Fusion text) ---
    -- Same rule as the item-master INTERFACE tier: a category interface row with
    -- no base assignment is a rejection; FUSION_STATUS='ERROR' and ERROR_MESSAGE
    -- carries the real EGP_IMPORT_ERRORS text (EGP_ITEM_CATEGORIES_INTERFACE),
    -- with a short fallback only when Fusion left no error row.
    SELECT 'ItemCategory'                                                        AS object_type,
           ic.item_number || '~' || ic.organization_code || '~'
             || ic.category_set_name || '~' || ic.category_code                  AS record_key,
           'INTERFACE'                                                          AS source_type,
           'ERROR'                                                             AS fusion_status,
           -- VARCHAR2 to match the other branches' fusion_id (BIP derives one
           -- datatype per UNION column; a NUMBER here 500s the report).
           CAST(NULL AS VARCHAR2(100))                                         AS fusion_id,
           '[CATEGORY] ' || NVL(ce.error_message,
               'Rejected by Item Import (process_status='
               || NVL(TO_CHAR(ic.process_status), 'NULL')
               || '; category assignment not created in base table '
               || 'EGP_ITEM_CATEGORIES).')                                      AS error_message,
           TO_CHAR(ic.load_request_id)                                          AS load_request_id,
           ic.item_number                                                       AS source_ref,
           CAST(NULL AS VARCHAR2(240))                                          AS dmt_reference
    FROM   egp_item_categories_interface ic
    LEFT   JOIN egp_item_categories b
           ON b.inventory_item_id = ic.inventory_item_id
          AND b.organization_id   = ic.organization_id
          AND b.category_id       = ic.category_id
          AND b.category_set_id   = ic.category_set_id
    LEFT   JOIN (
        SELECT e.transaction_id,
               LISTAGG(
                   CASE WHEN e.error_column_name IS NOT NULL
                        THEN e.error_column_name || ': ' || e.message_text
                        ELSE e.message_text END,
                   ' | ') WITHIN GROUP (ORDER BY e.error_id) AS error_message
        FROM   egp_import_errors e
        WHERE  e.transaction_id > 0
        AND    e.error_table_name = 'EGP_ITEM_CATEGORIES_INTERFACE'
        GROUP BY e.transaction_id
    ) ce ON ce.transaction_id = ic.transaction_id
    WHERE  :P_PREFIX IS NOT NULL
    AND    ic.item_number LIKE :P_PREFIX || '%'
    AND    b.item_category_assignment_id IS NULL

    UNION ALL

    -- ---- Item category, BASE tier (positive proof -> LOADED) ----------------
    SELECT 'ItemCategory'                                                        AS object_type,
           ic.item_number || '~' || ic.organization_code || '~'
             || ic.category_set_name || '~' || ic.category_code                  AS record_key,
           'BASE'                                                              AS source_type,
           'SUCCESS'                                                           AS fusion_status,
           -- Category tier stays OWN-grain (ITEM_CATEGORY_ASSIGNMENT_ID); wrapped
           -- in TO_CHAR only so both tiers share the one string FUSION_ID column.
           TO_CHAR(b.item_category_assignment_id)                              AS fusion_id,
           CAST(NULL AS VARCHAR2(4000))                                         AS error_message,
           TO_CHAR(ic.load_request_id)                                          AS load_request_id,
           ic.item_number                                                       AS source_ref,
           CAST(NULL AS VARCHAR2(240))                                          AS dmt_reference
    FROM   egp_item_categories_interface ic
    JOIN   egp_item_categories b
           ON b.inventory_item_id = ic.inventory_item_id
          AND b.organization_id   = ic.organization_id
          AND b.category_id       = ic.category_id
          AND b.category_set_id   = ic.category_set_id
    WHERE  :P_PREFIX IS NOT NULL
    AND    ic.item_number LIKE :P_PREFIX || '%'
)
WHERE  (:P_AFTER_KEY IS NULL OR record_key > :P_AFTER_KEY)
ORDER BY record_key
FETCH FIRST :P_CHUNK_SIZE ROWS ONLY
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="items_recon">
          <element name="OBJECT_TYPE"     value="OBJECT_TYPE"     dataType="xsd:string"  tagName="OBJECT_TYPE"/>
          <element name="RECORD_KEY"      value="RECORD_KEY"      dataType="xsd:string"  tagName="RECORD_KEY"/>
          <element name="SOURCE_TYPE"     value="SOURCE_TYPE"     dataType="xsd:string"  tagName="SOURCE_TYPE"/>
          <element name="FUSION_STATUS"   value="FUSION_STATUS"   dataType="xsd:string"  tagName="FUSION_STATUS"/>
          <element name="FUSION_ID"       value="FUSION_ID"       dataType="xsd:string"  tagName="FUSION_ID"/>
          <element name="ERROR_MESSAGE"   value="ERROR_MESSAGE"   dataType="xsd:string"  tagName="ERROR_MESSAGE"/>
          <element name="LOAD_REQUEST_ID" value="LOAD_REQUEST_ID" dataType="xsd:string"  tagName="LOAD_REQUEST_ID"/>
          <element name="SOURCE_REF"      value="SOURCE_REF"      dataType="xsd:string"  tagName="SOURCE_REF"/>
          <element name="DMT_REFERENCE"   value="DMT_REFERENCE"   dataType="xsd:string"  tagName="DMT_REFERENCE"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_RUN_ID" dataType="character" rowPlacement="1"
               labelID="P_RUN_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_LOAD_REQUEST_ID" dataType="character" rowPlacement="2"
               labelID="P_LOAD_REQUEST_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_IMPORT_ESS_ID" dataType="character" rowPlacement="3"
               labelID="P_IMPORT_ESS_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_PREFIX" dataType="character" rowPlacement="4"
               labelID="P_PREFIX" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_CHUNK_SIZE" dataType="integer" rowPlacement="5"
               labelID="P_CHUNK_SIZE" defaultValue="5000" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
    <parameter name="P_AFTER_KEY" dataType="character" rowPlacement="6"
               labelID="P_AFTER_KEY" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
