<?xml version="1.0" encoding="utf-8"?>
<dataModel xmlns="http://xmlns.oracle.com/oxp/xmlp" version="2.1"
           defaultDataSourceRef="ApplicationDB_FSCM">
  <dataProperties>
    <property name="include_parameters" value="true"/>
    <property name="include_null_Element" value="true"/>
    <property name="include_rowsettag" value="false"/>
    <property name="xml_tag_case" value="upper"/>
  </dataProperties>
  <dataSets>
    <dataSet name="fa_cmp_results" type="complex">
      <sql dataSourceRef="ApplicationDB_FSCM"><![CDATA[
-- Book scope (bk.book_type_code = ma.book_type_code): an asset routinely
-- belongs to MULTIPLE books (corporate + tax/state), so joining fa_books by
-- asset alone fans out to one row per book and would double SUCCESS_COUNT /
-- SUCCESS_AMOUNT and let MAX(currency) pick an arbitrary book. Scope to the
-- exact book the mass addition targeted so each asset contributes one book row.
SELECT COUNT(*)                    AS success_count,
       NVL(SUM(bk.cost), 0)        AS success_amount,
       MAX(gl.currency_code)       AS amount_currency
FROM   fa_mass_additions ma
JOIN   fa_additions_b a  ON a.asset_id = ma.asset_id
JOIN   fa_books bk       ON bk.asset_id = a.asset_id
                       AND bk.book_type_code = ma.book_type_code
                       AND bk.transaction_header_id_out IS NULL
JOIN   fa_book_controls bc ON bc.book_type_code = bk.book_type_code
JOIN   gl_ledgers gl       ON gl.ledger_id = bc.set_of_books_id
WHERE  ma.posting_status = 'POSTED'
AND    ma.load_request_id IN (
         SELECT TO_NUMBER(REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL))
         FROM dual CONNECT BY REGEXP_SUBSTR(:P_BATCH_ID, '[^,]+', 1, LEVEL) IS NOT NULL
       )
      ]]></sql>
    </dataSet>
  </dataSets>
  <output rootName="DATA_DS" uniqueRowName="false">
    <nodeList name="data-structure">
      <dataStructure tagName="DATA_DS">
        <group name="G_1" label="G_1" source="fa_cmp_results">
          <element name="SUCCESS_COUNT"    value="SUCCESS_COUNT"    dataType="xsd:string" tagName="SUCCESS_COUNT"/>
          <element name="SUCCESS_AMOUNT"   value="SUCCESS_AMOUNT"   dataType="xsd:string" tagName="SUCCESS_AMOUNT"/>
          <element name="AMOUNT_CURRENCY"  value="AMOUNT_CURRENCY"  dataType="xsd:string" tagName="AMOUNT_CURRENCY"/>
        </group>
      </dataStructure>
    </nodeList>
  </output>
  <eventTriggers/>
  <lexicals/>
  <parameters>
    <parameter name="P_BATCH_ID" dataType="character" rowPlacement="1"
               labelID="P_BATCH_ID" defaultValue="" nvp="false"
               refreshParamOnChange="false" useNullForAll="false"/>
  </parameters>
  <valueSets/>
  <bursting/>
</dataModel>
