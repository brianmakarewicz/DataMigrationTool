page 33 (
    name: Segment Values
    alias: SEGMENT-VALUES
    title: Segment Values
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region segment-values (
        name: Segment Values
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT segment_value_id, segment_map_id,
                       source_value, target_value,
                       active_flag, notes,
                       created_by, created_date
                FROM DMT_COA_SEGMENT_VALUES
                WHERE segment_map_id = :P33_SEGMENT_MAP_ID
                  AND suggested_flag = 'N'
                ORDER BY source_value
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50051497858930263
        }

        savedReport 500519 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SEGMENT_VALUE_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @SEGMENT_MAP_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SOURCE_VALUE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @TARGET_VALUE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ACTIVE_FLAG
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @NOTES
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @CREATED_BY
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @CREATED_DATE
                layout {
                    sequence: 8
                }
            )

        )

        column ACTIVE_FLAG (
            type: textField
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 1
            }
            source {
                databaseColumn: ACTIVE_FLAG
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREATED_BY (
            type: textField
            heading {
                heading: Created By
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CREATED_DATE (
            type: datePicker
            heading {
                heading: Created Date
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CREATED_DATE
                dataType: date
            }
        )

        column NOTES (
            type: textarea
            heading {
                heading: Notes
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: NOTES
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column SEGMENT_MAP_ID (
            type: numberField
            heading {
                heading: Segment Map Id
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: SEGMENT_MAP_ID
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SEGMENT_VALUE_ID (
            type: numberField
            heading {
                heading: Segment Value Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: SEGMENT_VALUE_ID
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SOURCE_VALUE (
            type: textField
            heading {
                heading: Source Value
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: SOURCE_VALUE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TARGET_VALUE (
            type: textField
            heading {
                heading: Target Value
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: TARGET_VALUE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Segment Values
        }
    )

    region suggested-mappings (
        name: Suggested Mappings
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT APEX_ITEM.CHECKBOX2(1, segment_value_id, 'CHECKED') AS select_row,
                       segment_value_id,
                       source_value,
                       target_value,
                       match_score,
                       notes
                FROM DMT_LOOKUP.DMT_COA_SEGMENT_VALUES
                WHERE segment_map_id = :P33_SEGMENT_MAP_ID
                  AND suggested_flag = 'Y'
                  AND active_flag = 'N'
                ORDER BY match_score DESC
                ```
        }
        layout {
            sequence: 60
            parentRegion: @segment-values
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column MATCH_SCORE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Match Score
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column NOTES (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Notes
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column SEGMENT_VALUE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenField
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column SELECT_ROW (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SOURCE_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Source Value
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column TARGET_VALUE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Target Value
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P33_SEGMENT_INFO (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @suggested-mappings
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P33_SEGMENT_MAP_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @segment-values
            slot: regionBody
        }
    )

    button accept-selected (
        buttonName: ACCEPT_SELECTED
        label: Accept Selected
        layout {
            sequence: 40
            region: @segment-values
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button auto-map-exact (
        buttonName: AUTO_MAP_EXACT
        label: Auto-Map Exact
        layout {
            sequence: 20
            region: @segment-values
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reject-selected (
        buttonName: REJECT_SELECTED
        label: Reject Selected
        layout {
            sequence: 50
            region: @segment-values
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button suggest-fuzzy (
        buttonName: SUGGEST_FUZZY
        label: Suggest Fuzzy Matches
        layout {
            sequence: 30
            region: @segment-values
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process accept-selected (
        name: Accept Selected
        type: executeCode
        source {
            plsqlCode: DECLARE l_ids VARCHAR2(4000); BEGIN FOR i IN 1..APEX_APPLICATION.G_F01.COUNT LOOP l_ids := l_ids || ':' || APEX_APPLICATION.G_F01(i); END LOOP; l_ids := LTRIM(l_ids, ':'); IF l_ids IS NOT NULL THEN DMT_COA_SUGGEST_PKG.ACCEPT_SUGGESTIONS(l_ids); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := 'Suggestions accepted.'; END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 49623044008489232
        }
        serverSideCondition {
            whenButtonPressed: @accept-selected
        }
    )

    process auto-map-exact (
        name: Auto-Map Exact
        type: executeCode
        source {
            plsqlCode: DECLARE v_cnt NUMBER; BEGIN v_cnt := DMT_COA_SUGGEST_PKG.AUTO_MAP_EXACT(:P33_SEGMENT_MAP_ID); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := v_cnt || ' exact matches auto-mapped.'; END;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49622839278489230
        }
        serverSideCondition {
            whenButtonPressed: @auto-map-exact
        }
    )

    process reject-selected (
        name: Reject Selected
        type: executeCode
        source {
            plsqlCode: DECLARE l_ids VARCHAR2(4000); BEGIN FOR i IN 1..APEX_APPLICATION.G_F01.COUNT LOOP l_ids := l_ids || ':' || APEX_APPLICATION.G_F01(i); END LOOP; l_ids := LTRIM(l_ids, ':'); IF l_ids IS NOT NULL THEN DMT_COA_SUGGEST_PKG.REJECT_SUGGESTIONS(l_ids); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := 'Suggestions rejected.'; END IF; END;
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 49623199799489233
        }
        serverSideCondition {
            whenButtonPressed: @reject-selected
        }
    )

    process suggest-fuzzy (
        name: Suggest Fuzzy
        type: executeCode
        source {
            plsqlCode: DECLARE v_cnt NUMBER; BEGIN v_cnt := DMT_COA_SUGGEST_PKG.SUGGEST_SEGMENT_VALUES(:P33_SEGMENT_MAP_ID); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := v_cnt || ' fuzzy suggestions generated.'; END;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49622916013489231
        }
        serverSideCondition {
            whenButtonPressed: @suggest-fuzzy
        }
    )

)

