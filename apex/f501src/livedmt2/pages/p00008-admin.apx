page 8 (
    name: Administration
    alias: ADMIN
    title: Administration
    appearance {
        pageTemplate: @/standard
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region bip-report-registry (
        name: BIP Report Registry
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN IF :G_SECTION IS NULL OR :G_SECTION='BIP' THEN dmt_render_view('DMT_BIP_REPORTS_ADMIN_V','BIP Report'); END IF; END;
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    region daily-run-metrics (
        name: Daily Run Metrics
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN IF :G_SECTION IS NULL OR :G_SECTION='METRICS' THEN dmt_render_view('DMT_RUN_METRICS_V','Run Metric'); END IF; END;
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    region ess-job-files (
        name: ESS Job Files
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN IF :G_SECTION IS NULL OR :G_SECTION='ESS' THEN dmt_render_view('DMT_ESS_JOB_FILES_V','ESS Job File'); END IF; END;
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    region ess-job-monitor (
        name: ESS Job Monitor
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN IF :G_SECTION IS NULL OR :G_SECTION='ESS' THEN dmt_render_view('DMT_ESS_JOBS_MONITOR_V','ESS Job'); END IF; END;
        }
        layout {
            sequence: 10
            slot: body
        }
    )

    region system-configuration (
        name: System Configuration
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN IF :G_SECTION IS NULL OR :G_SECTION='CONFIG' THEN dmt_render_view('DMT_CONFIG_ADMIN_V','Configuration'); END IF; END;
        }
        layout {
            sequence: 40
            slot: body
        }
    )

)

