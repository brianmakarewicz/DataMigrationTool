page 85 (
    name: Run Comparison
    alias: P85-RUN-COMPARISON
    title: Run Comparison
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region filters (
        name: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: #DEFAULT#
        }
    )

    region status-bar (
        name: Status
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_n  NUMBER;
                    l_ts TIMESTAMP;
                BEGIN
                    IF :P85_RUN_ID IS NULL THEN
                        htp.p('<p style="padding:8px 0;color:#666">Select a run above and click Go.</p>');
                        RETURN;
                    END IF;
                    SELECT COUNT(*), MAX(COMPUTED_DATE) INTO l_n, l_ts
                      FROM DMT_RUN_COMPARISON_TBL WHERE RUN_ID = :P85_RUN_ID;
                    IF l_n = 0 THEN
                        htp.p('<div style="padding:10px 12px;background:#fff8e1;border:1px solid #ffe0a3;'
                            || 'border-radius:6px;color:#7a5c00">This run has not been computed yet. Click '
                            || '<b>Refresh from Fusion</b> to pull the live comparison (takes ~15s).</div>');
                    ELSE
                        htp.p('<div style="padding:6px 0;color:#555;font-size:12px">Showing stored results as of <b>'
                            || TO_CHAR(l_ts, 'YYYY-MM-DD HH24:MI:SS')
                            || '</b>. Click <b>Refresh from Fusion</b> to re-pull the live numbers.</div>');
                    END IF;
                END;
                ```
        }
        layout {
            sequence: 12
            slot: body
        }
    )

    region totals (
        name: Totals
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_stg_count   NUMBER;
                    l_stg_amount  NUMBER;
                    l_err_count   NUMBER;
                    l_err_amount  NUMBER;
                    l_fus_count   NUMBER;
                    l_fus_amount  NUMBER;
                    l_var_count   NUMBER;
                    l_var_amount  NUMBER;
                BEGIN
                    IF :P85_RUN_ID IS NULL THEN RETURN; END IF;
                    SELECT SUM(STG_COUNT), SUM(STG_AMOUNT), SUM(TFM_ERROR_COUNT), SUM(TFM_ERROR_AMOUNT),
                           SUM(FUSION_SUCCESS_COUNT), SUM(FUSION_SUCCESS_AMOUNT), SUM(VARIANCE_COUNT), SUM(VARIANCE_AMOUNT)
                      INTO l_stg_count, l_stg_amount, l_err_count, l_err_amount,
                           l_fus_count, l_fus_amount, l_var_count, l_var_amount
                      FROM DMT_RUN_COMPARISON_TBL WHERE RUN_ID = :P85_RUN_ID;

                    IF l_stg_count IS NULL THEN RETURN; END IF;
                    htp.p('<div style="margin:8px 0;font-weight:600">Totals &mdash; '
                        || 'Staged: ' || NVL(TO_CHAR(l_stg_count), '0') || ' rows / ' || NVL(TO_CHAR(l_stg_amount), '0')
                        || ' &nbsp;|&nbsp; Errors: ' || NVL(TO_CHAR(l_err_count), '0') || ' rows / ' || NVL(TO_CHAR(l_err_amount), '0')
                        || ' &nbsp;|&nbsp; Fusion Success: ' || NVL(TO_CHAR(l_fus_count), '0') || ' rows / ' || NVL(TO_CHAR(l_fus_amount), '0')
                        || ' &nbsp;|&nbsp; Variance: ' || NVL(TO_CHAR(l_var_count), '0') || ' rows / ' || NVL(TO_CHAR(l_var_amount), '0')
                        || '</div>');
                END;
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
    )

    region overview (
        name: Overview
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_pp   VARCHAR2(100) := '***';
                    l_url  VARCHAR2(4000);
                    l_bal  VARCHAR2(20);
                    l_edge VARCHAR2(20);
                    l_soft VARCHAR2(20);
                BEGIN
                    IF :P85_RUN_ID IS NULL THEN RETURN; END IF;
                    FOR r IN (
                        SELECT c.OBJECT_TYPE, c.IN_BALANCE, c.FUSION_MONEY_AVAILABLE money_avail,
                               c.NOTE, c.STG_COUNT stg_cnt, c.STG_AMOUNT stg_amt,
                               c.TFM_ERROR_COUNT err_cnt, c.TFM_ERROR_AMOUNT err_amt,
                               c.FUSION_SUCCESS_COUNT fus_cnt, c.FUSION_SUCCESS_AMOUNT fus_amt,
                               NVL(sv.PIPELINE, 'Other') pipeline
                          FROM DMT_RUN_COMPARISON_TBL c
                          LEFT JOIN (
                                SELECT OBJECT_TYPE,
                                       MAX(PIPELINE)   PIPELINE,
                                       MIN(SORT_ORDER) SORT_ORDER
                                  FROM DMT_PIPELINE_SUMMARY_V
                                 WHERE RUN_ID = :P85_RUN_ID
                                   AND OBJECT_TYPE != '__PIPELINE__'
                                 GROUP BY OBJECT_TYPE
                               ) sv
                            ON sv.OBJECT_TYPE = c.OBJECT_TYPE
                         WHERE c.RUN_ID = :P85_RUN_ID
                         ORDER BY CASE NVL(sv.PIPELINE, 'zzz')
                                    WHEN 'Configuration' THEN 0 WHEN 'MasterData' THEN 1
                                    WHEN 'P2P' THEN 2 WHEN 'O2C' THEN 3 WHEN 'Financials' THEN 4
                                    WHEN 'Projects' THEN 5 WHEN 'Standalone' THEN 6 WHEN 'HCM' THEN 7
                                    ELSE 9 END,
                                  NVL(sv.SORT_ORDER, 999), c.OBJECT_TYPE
                    ) LOOP
                        IF r.pipeline != l_pp THEN
                            IF l_pp != '***' THEN htp.p('</div>'); END IF;
                            htp.p('<h3 style="margin:20px 0 8px;font-size:13px;color:#555;text-transform:uppercase;letter-spacing:1px">'
                                || APEX_ESCAPE.HTML(r.pipeline) || '</h3>'
                                || '<div style="display:flex;flex-wrap:wrap;gap:12px">');
                            l_pp := r.pipeline;
                        END IF;

                        IF r.in_balance = 'Y' THEN
                            l_edge := '#2e8b57'; l_soft := '#cfe8d4'; l_bal := '&#10003; In balance';
                        ELSIF r.in_balance = 'N' THEN
                            l_edge := '#cc0000'; l_soft := '#f3c9c9'; l_bal := 'Out of balance';
                        ELSE
                            l_edge := '#b8860b'; l_soft := '#f0e0b0'; l_bal := 'Unresolved';
                        END IF;

                        l_url := APEX_PAGE.GET_URL(p_page => 52,
                                     p_items => 'P52_RUN_ID,P52_CEMLI_CODE',
                                     p_values => :P85_RUN_ID || ',' || r.object_type);

                        htp.p('<div style="border:1px solid ' || l_soft || ';border-left:4px solid ' || l_edge
                            || ';border-radius:8px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.05);'
                            || 'padding:12px 14px;min-width:230px;max-width:290px">');
                        htp.p('<div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px">'
                            || '<span style="font-weight:700;color:#16191f">' || APEX_ESCAPE.HTML(r.object_type) || '</span>'
                            || '<span style="font-size:11px;font-weight:700;color:' || l_edge || '">' || l_bal || '</span></div>');
                        htp.p('<div style="margin-top:8px;font-size:12px;color:#333;display:flex;flex-direction:column;gap:2px">');
                        htp.p('<div>Staged: <b>' || r.stg_cnt || '</b>'
                            || CASE WHEN r.money_avail = 'Y' THEN ' ($' || TO_CHAR(r.stg_amt, 'FM999G999G990D00') || ')' END || '</div>');
                        htp.p('<div>Errors: <b>' || r.err_cnt || '</b>'
                            || CASE WHEN r.money_avail = 'Y' THEN ' ($' || TO_CHAR(r.err_amt, 'FM999G999G990D00') || ')' END
                            || CASE WHEN r.err_cnt > 0 THEN ' <a href="' || l_url
                                 || '" style="color:#0072c6;text-decoration:none">view &rarr;</a>' END || '</div>');
                        htp.p('<div>Loaded: <b>' || r.fus_cnt || '</b>'
                            || CASE WHEN r.money_avail = 'Y' THEN ' ($' || TO_CHAR(r.fus_amt, 'FM999G999G990D00') || ')' END || '</div>');
                        htp.p('</div>');
                        IF r.note IS NOT NULL THEN
                            htp.p('<div style="margin-top:8px;font-size:11px;color:#777;line-height:1.35">'
                                || APEX_ESCAPE.HTML(r.note) || '</div>');
                        END IF;
                        htp.p('</div>');
                    END LOOP;
                    IF l_pp != '***' THEN htp.p('</div>'); END IF;
                END;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region comparison (
        name: Detailed comparison
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT OBJECT_TYPE,
                       IN_BALANCE,
                       DECODE(IN_BALANCE, 'Y', 'In balance', 'N', 'Out of balance', 'Unresolved') AS status_label,
                       DECODE(IN_BALANCE, 'N', 't-Badge t-Badge--danger', 'Y', 't-Badge t-Badge--success', 't-Badge t-Badge--warning') AS in_balance_badge_class,
                       NOTE,
                       CASE WHEN NOTE IS NOT NULL THEN 'inline-block' ELSE 'none' END AS note_disp,
                       KEY_TYPE,
                       FUSION_MONEY_AVAILABLE,
                       AMOUNT_CURRENCY,
                       STG_COUNT AS staged_count,
                       CASE WHEN FUSION_MONEY_AVAILABLE = 'Y' THEN TO_CHAR(STG_AMOUNT, 'FM$999G999G990D00') END AS staged_amt,
                       TFM_ERROR_COUNT AS error_count,
                       CASE WHEN FUSION_MONEY_AVAILABLE = 'Y' THEN TO_CHAR(TFM_ERROR_AMOUNT, 'FM$999G999G990D00') END AS error_amt,
                       FUSION_SUCCESS_COUNT AS loaded_count,
                       CASE WHEN FUSION_MONEY_AVAILABLE = 'Y' THEN TO_CHAR(FUSION_SUCCESS_AMOUNT, 'FM$999G999G990D00') END AS loaded_amt,
                       VARIANCE_COUNT AS variance_count,
                       CASE WHEN FUSION_MONEY_AVAILABLE = 'Y' THEN TO_CHAR(VARIANCE_AMOUNT, 'FM$999G999G990D00') END AS variance_amt,
                       APEX_PAGE.GET_URL(p_page => 52,
                           p_items => 'P52_RUN_ID,P52_CEMLI_CODE',
                           p_values => :P85_RUN_ID || ',' || OBJECT_TYPE) AS errors_link
                  FROM DMT_RUN_COMPARISON_TBL
                 WHERE RUN_ID = :P85_RUN_ID
                 ORDER BY OBJECT_TYPE
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }

        column STATUS_LABEL (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            columnFormatting {
                htmlExpression: <span class="#IN_BALANCE_BADGE_CLASS#">#STATUS_LABEL#</span>
            }
        )

        column OBJECT_TYPE (
            type: plainText
            heading {
                heading: Object
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            columnFormatting {
                htmlExpression: <span style="font-weight:600">#OBJECT_TYPE#</span> <span title="#NOTE#" style="display:#NOTE_DISP#;cursor:help;background:#0072c6;color:#fff;border-radius:50%;width:16px;height:16px;line-height:16px;text-align:center;font-size:10px;font-weight:700">i</span>
            }
        )

        column STAGED_COUNT (
            type: plainText
            heading {
                heading: Staged
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column STAGED_AMT (
            type: plainText
            heading {
                heading: Staged $
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
        )

        column ERROR_COUNT (
            type: plainText
            heading {
                heading: Errors
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            columnFormatting {
                htmlExpression: <a href="#ERRORS_LINK#" style="color:#0072c6;text-decoration:none" title="View failed records">#ERROR_COUNT#</a>
            }
        )

        column ERROR_AMT (
            type: plainText
            heading {
                heading: Errors $
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
        )

        column LOADED_COUNT (
            type: plainText
            heading {
                heading: Loaded to Fusion
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column LOADED_AMT (
            type: plainText
            heading {
                heading: Loaded $
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
        )

        column VARIANCE_COUNT (
            type: plainText
            heading {
                heading: Variance
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

        column VARIANCE_AMT (
            type: plainText
            heading {
                heading: Variance $
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: STRING
            }
        )

        column IN_BALANCE (
            type: hidden
            heading {
                heading: In Balance
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
        )

        column IN_BALANCE_BADGE_CLASS (
            type: hidden
            heading {
                heading: In Balance Badge Class
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
        )

        column NOTE (
            type: hidden
            heading {
                heading: Note
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
        )

        column NOTE_DISP (
            type: hidden
            heading {
                heading: Note Display
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
        )

        column ERRORS_LINK (
            type: hidden
            heading {
                heading: Errors Link
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
        )

        column KEY_TYPE (
            type: hidden
            heading {
                heading: Key Type
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
        )

        column FUSION_MONEY_AVAILABLE (
            type: hidden
            heading {
                heading: Fusion Money Available
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
        )

        column AMOUNT_CURRENCY (
            type: hidden
            heading {
                heading: Currency
            }
            layout {
                sequence: 180
            }
            source {
                dataType: STRING
            }
        )

    )

    pageItem P85_RUN_ID (
        type: selectList
        label {
            label: Run
            alignment: left
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT RUN_ID || ' - ' || RUN_STATUS || ' (' || TO_CHAR(SUBMITTED_DATE, 'YYYY-MM-DD HH24:MI') || ')' d,
                       RUN_ID r
                  FROM DMT_PIPELINE_RUN_TBL
                 ORDER BY RUN_ID DESC
                FETCH FIRST 50 ROWS ONLY
                ```
            displayExtraValues: true
            nullDisplayValue: - Select a run -
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    button go (
        buttonName: GO
        label: Go
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh from Fusion
        layout {
            sequence: 30
            region: @filters
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-comparison (
        name: Save comparison from Fusion
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P85_RUN_ID IS NOT NULL THEN
                        DMT_RUN_COMPARE_PKG.SAVE_RUN_COMPARISON(:P85_RUN_ID);
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @refresh
        }
    )

)
