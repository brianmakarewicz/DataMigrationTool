    pageItem P17_DEFAULT_VALUE (
        type: selectList
        label {
            label: Type Default
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT fusion_value || NVL2(fusion_description, ' -- ' || fusion_description, '') AS d, fusion_value AS r FROM DMT_LOOKUP.DMT_LKP_FUSION_VALUES WHERE lookup_type = :P17_LOOKUP_TYPE AND active_flag = 'Y' ORDER BY fusion_value
            nullDisplayValue: - No Default (pass-through) -
        }
        cascadingLov {
            parentItems: P17_LOOKUP_TYPE
        }
        layout {
            sequence: 10
            region: @value-mapping
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            postText: <button type="button" class="t-Button t-Button--simple t-Button--primary" style="margin-left:8px;" onclick="apex.event.trigger('#P17_DEFAULT_VALUE','change');">Save</button>
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: SELECT NVL(default_fusion_value, '(Not set)') FROM DMT_LOOKUP.DMT_LKP_TYPE_CONFIG WHERE lookup_type = :P17_LOOKUP_TYPE
            used: always
        }
    )

    pageItem P17_LOOKUP_TYPE (
        type: selectList
        label {
            label: Lookup Type
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT lookup_type d, lookup_type r FROM DMT_LOOKUP.DMT_LKP_TYPE_CONFIG ORDER BY 1
        }
        layout {
            sequence: 1
            region: @value-mapping
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

