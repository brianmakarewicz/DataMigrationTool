    dynamicAction save-default-value-on-change (
        name: Save Default Value on Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P17_DEFAULT_VALUE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    UPDATE DMT_LOOKUP.DMT_LKP_TYPE_CONFIG
                       SET default_fusion_value = NULLIF(:P17_DEFAULT_VALUE, '')
                     WHERE lookup_type = :P17_LOOKUP_TYPE;
                    COMMIT;
                    ```
                itemsToSubmit: [
                    P17_DEFAULT_VALUE
                    P17_LOOKUP_TYPE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Default value saved.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

