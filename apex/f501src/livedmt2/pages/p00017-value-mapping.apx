    dynamicAction refresh-default-value-on-type-change (
        name: Refresh Default Value on Type Change
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P17_LOOKUP_TYPE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT default_fusion_value FROM DMT_LOOKUP.DMT_LKP_TYPE_CONFIG WHERE lookup_type = :P17_LOOKUP_TYPE
                itemsToSubmit: P17_LOOKUP_TYPE
            }
            affectedElements {
                selectionType: items
