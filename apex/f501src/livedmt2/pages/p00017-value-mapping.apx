    process accept-selected-suggestions (
        name: Accept Selected Suggestions
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_ids VARCHAR2(32767);
                BEGIN
                  FOR i IN 1..APEX_APPLICATION.G_F01.COUNT LOOP
                    l_ids := l_ids || ':' || APEX_APPLICATION.G_F01(i);
                  END LOOP;
                  l_ids := LTRIM(l_ids, ':');
                  IF l_ids IS NOT NULL THEN
                    DMT_LOOKUP.DMT_LKP_SUGGEST_PKG.ACCEPT_SUGGESTIONS(l_ids);
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49051449049010033
