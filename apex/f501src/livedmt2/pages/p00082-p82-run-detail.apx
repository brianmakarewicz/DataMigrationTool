page 82 (
    name: Run Detail
    alias: P82-RUN-DETAIL
    title: Run Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region queue (
        name: Queue
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN DMT_APEX_PAGE_PKG.RENDER_RUN_TILES(:P82_RUN_ID); END;
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    region run-info (
        name: Run Info
        type: plSqlDynamicContent
        source {
            plsqlCode: BEGIN DMT_APEX_PAGE_PKG.RENDER_RUN_HEADER(:P82_RUN_ID); END;
        }
        layout {
            sequence: 10
            slot: body
        }
    )

    region activity-log-link (
        name: Activity Log Link
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  htp.p('<div style="margin:4px 0 12px 0"><a href="'
                    || APEX_PAGE.GET_URL(p_page => 54, p_items => 'P54_RUN_ID', p_values => TO_CHAR(:P82_RUN_ID), p_clear_cache => '54')
                    || '" style="color:#0070d2;text-decoration:none;font-weight:600">View activity log for this run &rarr;</a></div>');
                END;
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
    )

    pageItem P82_RUN_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button back (
        buttonName: BACK
        label: Run History
        layout {
            sequence: 5
            region: @run-info
            slot: PREVIOUS
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

