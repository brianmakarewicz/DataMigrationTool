    pageItem P11_SCENARIO (
        type: selectList
        label {
            label: Scenario
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT scenario_name d, scenario_name r FROM dmt_scenario_tbl WHERE status = 'ACTIVE' ORDER BY scenario_name
            displayExtraValues: false
            nullDisplayValue: -- No Scenario --
        }
        layout {
            sequence: 15
            region: @bulk-upload
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P11_UPLOAD_FILE (
        type: fileUpload
        label {
            label: Upload File
            alignment: left
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 20
            region: @bulk-upload
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P11_UPLOAD_OBJECT (
        type: selectList
        label {
            label: Target Object
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISPLAY_NAME d, OBJECT_CODE r
                FROM DMT_UPLOAD_OBJECT_TBL
                WHERE PAGE_NUMBER = 11 AND IS_ACTIVE = 'Y'
                ORDER BY DISPLAY_ORDER
                ```
        }
        layout {
            sequence: 10
            region: @bulk-upload
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button upload-csv (
        buttonName: UPLOAD_CSV
        label: Upload CSV
        layout {
            sequence: 30
            region: @bulk-upload
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process upload-csv (
        name: Upload CSV
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_rows_loaded  NUMBER;
                    l_rows_errored NUMBER;
                    l_batch_id     NUMBER;
                    l_error_msg    VARCHAR2(4000);
                BEGIN
                    DMT_CSV_UPLOAD_PKG.UPLOAD_CSV(
                        p_file_name    => :P11_UPLOAD_FILE,
                        p_object_code  => :P11_UPLOAD_OBJECT,
                        p_rows_loaded  => l_rows_loaded,
                        p_rows_errored => l_rows_errored,
                        p_batch_id_out => l_batch_id,
                        p_error_msg     => l_error_msg,
                        p_scenario_name => :P11_SCENARIO
                    );
                    IF l_error_msg IS NOT NULL THEN
                        APEX_ERROR.ADD_ERROR(p_message => l_error_msg, p_display_location => 'INLINE_IN_NOTIFICATION');
                    ELSE
                        APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE :=
                            l_rows_loaded || ' rows loaded, ' || l_rows_errored || ' errors. Batch ID: ' || l_batch_id;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 22378974261102612
        }
        serverSideCondition {
            whenButtonPressed: @upload-csv
        }
    )

)

