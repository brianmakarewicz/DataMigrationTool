            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT display_name d, object_code r FROM dmt_upload_object_tbl WHERE is_active = 'Y' ORDER BY display_name
            displayExtraValues: false
            nullDisplayValue: -- Select Object Type --
        }
        layout {
            sequence: 20
            region: @upload-data-files
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
