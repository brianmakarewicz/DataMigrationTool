    region object-reference (
        name: Object Reference
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: SELECT object_code, display_name, csv_filename AS expected_filename, fbdi_csv_filename AS fbdi_filename FROM dmt_upload_object_tbl WHERE is_active = 'Y' ORDER BY display_name
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 99250031
        }

        column DISPLAY_NAME (
            type: plainText
            heading {
                heading: Display Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EXPECTED_FILENAME (
            type: plainText
            heading {
                heading: Expected Filename
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FBDI_FILENAME (
            type: plainText
            heading {
                heading: FBDI Filename
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column OBJECT_CODE (
            type: plainText
            heading {
                heading: Object Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 521821 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DISPLAY_NAME (
                sequence: 2
            )

            displayColumn EXPECTED_FILENAME (
                sequence: 3
            )

            displayColumn FBDI_FILENAME (
                sequence: 4
            )

            displayColumn OBJECT_CODE (
                sequence: 1
            )

        )

    )

    region upload-data-files (
        name: Upload Data Files
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="margin-bottom:16px">
                <p><strong>Three ways to upload:</strong></p>
                <ul>
                <li><strong>Manual:</strong> Select the file type from the dropdown, then upload any CSV file. The file must have a header row &mdash; column names determine the mapping. Filename does not matter.</li>
                <li><strong>Auto-detect CSV:</strong> Upload a CSV file named to match the expected format (e.g. <code>POZ_SUPPLIERS.csv</code>). Must have a header row.</li>
                <li><strong>ZIP bundle:</strong> Upload a ZIP file containing multiple CSVs. Each CSV is routed by its filename:
                  <ul>
                    <li>If the filename matches a <strong>staging CSV name</strong> (e.g. <code>POZ_SUPPLIERS.csv</code>) &rarr; parsed with headers</li>
                    <li>If the filename matches an <strong>FBDI template name</strong> (e.g. <code>PozSuppliersInt.csv</code>) &rarr; parsed positionally (no headers, column order per CTL spec)</li>
                    <li>Unrecognized filenames are skipped</li>
                  </ul>
                  The ZIP filename itself does not matter.</li>
                </ul>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region upload-errors (
        name: Upload Errors
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT e.BATCH_TAG,
                       e.LOG_ID AS BATCH,
                       e.ROW_NUMBER,
                       e.COLUMN_NAME,
                       e.ERROR_TYPE,
                       e.ERROR_MESSAGE,
                       e.RAW_VALUE,
                       TO_CHAR(e.CREATED_DATE, 'MM/DD HH24:MI') AS LOGGED_AT
                FROM DMT_UPLOAD_ERROR_TBL e
                ORDER BY e.LOG_ID DESC, e.ROW_NUMBER
                FETCH FIRST 200 ROWS ONLY
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 200
        }
        messages {
            whenNoDataFound: No upload errors found.
            whenMoreDataFound: Showing first 200 errors.
        }
        advanced {
            savedReportMappingIdentifier: 99250951
        }

