    pageItem P34_CONFIG_CODE (
        type: selectList
        label {
            label: Mapping Config
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT config_code || ' — ' || description AS d, config_code AS r FROM DMT_COA_MAP_CONFIG WHERE active_flag = 'Y' ORDER BY config_code
        }
        layout {
            sequence: 10
            region: @coa-crosswalk
            slot: regionBody
            alignment: left
        }
        appearance {
