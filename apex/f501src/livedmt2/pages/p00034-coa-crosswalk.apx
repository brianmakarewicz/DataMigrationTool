    region unmapped-source-combos (
        name: Unmapped Source Combos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT sc.concat_segments,
                       sc.segment1, sc.segment2, sc.segment3, sc.segment4, sc.segment5, sc.segment6
                FROM DMT_LOOKUP.DMT_COA_SOURCE_COMBOS sc
                JOIN DMT_LOOKUP.DMT_COA_MAP_CONFIG mc ON mc.source_coa_set_id = sc.coa_set_id
                WHERE mc.config_code = :P34_CONFIG_CODE
                  AND sc.enabled_flag = 'Y'
                  AND NOT EXISTS (
                      SELECT 1 FROM DMT_LOOKUP.DMT_COA_MAPPING m
                      WHERE m.map_config_id = mc.map_config_id
                      AND m.source_concat = sc.concat_segments
                      AND m.active_flag = 'Y'
                  )
                ORDER BY sc.concat_segments
                ```
        }
        layout {
            sequence: 20
            parentRegion: @coa-crosswalk
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

