    region segment-definitions (
        name: Segment Definitions
        title: Segment Definitions
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: SELECT segment_def_id, coa_set_id, segment_num, segment_name, segment_qualifier, value_set_name, description FROM DMT_COA_SEGMENT_DEF WHERE coa_set_id = :P31_COA_SET_ID
            pageItemsToSubmit: P31_COA_SET_ID
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        toolbar {
