    pageItem P31_COA_SET_ID (
        type: selectList
        label {
            label: COA Set
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT set_code || ' — ' || description AS d, coa_set_id AS r FROM DMT_COA_SET ORDER BY set_type, set_code
        }
        layout {
            sequence: 30
            region: @coa-sets
            slot: regionBody
            alignment: left
            startNewRow: false
