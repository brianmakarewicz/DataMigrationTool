                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @ACTIVE_FLAG
                layout {
                    sequence: 9
                }
            )

        )

        column ACTIVE_FLAG (
            type: textField
            heading {
                heading: Active Flag
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
                maxLength: 1
            }
            source {
                databaseColumn: ACTIVE_FLAG
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CHART_OF_ACCOUNTS_ID (
            type: numberField
            heading {
