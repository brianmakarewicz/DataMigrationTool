    process clear-generated (
        name: Clear Generated
        type: executeCode
        source {
            plsqlCode: BEGIN DMT_COA_MAP_PKG.CLEAR_GENERATED(:P32_CONFIG_CODE); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := 'Generated mappings cleared for ' || :P32_CONFIG_CODE; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 49622224466489224
        }
        serverSideCondition {
            whenButtonPressed: @clear-generated
        }
    )

    process generate-mappings (
        name: Generate Mappings
        type: executeCode
        source {
            plsqlCode: DECLARE v_cnt NUMBER; BEGIN v_cnt := DMT_COA_MAP_PKG.GENERATE_MAPPINGS(:P32_CONFIG_CODE); APEX_APPLICATION.G_PRINT_SUCCESS_MESSAGE := v_cnt || ' mappings generated for ' || :P32_CONFIG_CODE; END;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49622087866489222
        }
        serverSideCondition {
            whenButtonPressed: @generate-mappings
