    pageItem P35_COA_SET_ID (
        type: selectList
        label {
            label: Source COA Set
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT set_code || ' — ' || ledger_name AS d, coa_set_id AS r FROM DMT_COA_SET WHERE set_type='SOURCE' AND active_flag='Y' ORDER BY set_code
        }
        layout {
            sequence: 10
            region: @source-combinations
            slot: regionBody
            alignment: left
        }
        appearance {
