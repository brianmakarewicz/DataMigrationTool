    region bulk-upload (
        name: Bulk Upload
        type: staticContent
        source {
            htmlCode: <p>Upload a CSV file to bulk import data into the selected object's staging table. Select the target object, choose your file, and click Upload. See the <a href="f?p=&APP_ID.:9:&SESSION.">Upload Reference Guide</a> for file format details.</p>
        }
        layout {
            sequence: 999
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region customer-accounts (
        name: Customer Accounts
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: SELECT * FROM DMT_V_CUST_ACCOUNTS_DETAIL WHERE (:P0_SCENARIO_ID IS NULL OR SCENARIO_ID = :P0_SCENARIO_ID)
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        comments {
            comments: Customer Accounts — Account master records
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 38545186401267217
        }

