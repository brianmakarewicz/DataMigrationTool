            location: localDatabase
            type: sqlQuery
            sqlQuery: SELECT * FROM DMT_V_GRANT_PRJ_FUND_SRC_DETAIL WHERE (:P0_SCENARIO_ID IS NULL OR SCENARIO_ID = :P0_SCENARIO_ID)
        }
